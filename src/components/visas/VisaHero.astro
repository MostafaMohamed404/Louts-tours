<section
  class="relative min-h-[75vh] flex items-center justify-center overflow-hidden"
>
  <!-- Background -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/visa-hero.webp"
      alt="Tourist Visa Services Lotus Tours"
      class="w-full h-full object-cover"
      width="1920"
      height="1440"
      loading="eager"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/45 to-black/75"
    >
    </div>
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center text-white px-6 max-w-4xl mx-auto">
    <!-- Badge -->
    <div
      class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-5 py-2 mb-8"
    >
      <i class="fa-solid fa-passport text-[#C6A75E] text-sm"></i>
      <span class="text-sm font-medium tracking-wide">
        Visa Assistance Services
      </span>
    </div>

    <!-- Title -->
    <h1 class="text-5xl md:text-6xl font-bold leading-tight mb-6">
      Get Your Visa <br />
      <span class="text-[#C6A75E]">Fast & Easy</span>
    </h1>

    <!-- Description -->
    <p
      class="text-lg md:text-xl text-white/80 leading-relaxed max-w-2xl mx-auto mb-10"
    >
      We handle your visa process from start to finish with expert guidance,
      fast processing, and complete document support.
    </p>

    <!-- Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-3 bg-[#C6A75E] text-white font-semibold px-10 py-4 rounded-2xl hover:bg-[#b2965c] hover:scale-105 transition transform duration-300 shadow-xl"
      >
        <i class="fa-solid fa-paper-plane"></i>
        Apply Now
      </a>

      <a
        href="/services"
        class="inline-flex items-center justify-center gap-3 bg-white/10 backdrop-blur-sm border border-white/30 text-white font-semibold px-10 py-4 rounded-2xl hover:bg-white/20 hover:scale-105 transition transform duration-300"
      >
        <i class="fa-solid fa-layer-group"></i>
        View Services
      </a>
    </div>
  </div>
</section>
