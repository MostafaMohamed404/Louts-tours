<section
  class="relative min-h-[75vh] flex items-center justify-center overflow-hidden"
>
  <!-- Background -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero-religious.webp"
      alt="Discover Religious Travel Services with Lotus Travel"
      class="w-full h-full object-cover"
      width="1920"
      height="1440"
      loading="eager"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/45 to-black/80"
    >
    </div>
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center text-white px-6 max-w-4xl mx-auto">
    <!-- Badge -->
    <div
      class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-5 py-2 mb-8"
    >
      <i class="fa-solid fa-mosque text-[#C6A75E] text-sm"></i>
      <span class="text-sm font-medium tracking-wide">
        Hajj & Umrah Religious Tourism
      </span>
    </div>

    <!-- Title -->
    <h1 class="text-5xl md:text-6xl font-bold leading-tight mb-6">
      Hajj & Umrah with <span class="text-[#C6A75E]">Lotus </span>
