<div id="loader" class="loader-wrapper">
  <div class="loader-content">
    <!-- Brand -->
    <h1 class="brand">Lotus Tours</h1>

    <!-- Loader -->
    <div class="orbit">
      <div class="ring"></div>
      <div class="ring glow"></div>

      <!-- Plane -->
      <div class="plane">✈</div>
    </div>

    <p class="text">Preparing your journey...</p>
  </div>
</div>

<style>
  .loader-wrapper {
    position: fixed;
    inset: 0;
    background: radial-gradient(circle at center, #0f172a, #020617);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    transition:
      opacity 0.6s ease,
      visibility 0.6s ease;
  }

  .loader-wrapper.hidden {
    opacity: 0;
    visibility: hidden;
  }

  .loader-content {
    text-align: center;
  }

  /* Brand */
  .brand {
    font-family: "Georgia", serif;
    font-size: 2.5rem;
    background: linear-gradient(90deg, #c9a84c, #f5e6b3);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: 4px;
    margin-bottom: 40px;
  }

  /* Orbit */
  .orbit {
    position: relative;
    width: 120px;
    height: 120px;
    margin: 0 auto 25px;
  }

  .ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .ring.glow {
    border: 1px solid rgba(201, 168, 76, 0.5);
    box-shadow: 0 0 20px rgba(201, 168, 76, 0.4);
    animation: pulse 2s infinite ease-in-out;
  }

  /* Plane */
  .plane {
    position: absolute;
    top: 50%;
    left: 50%;
    transform-origin: -50px center;
    font-size: 20px;
    color: #f5e6b3;
    animation: orbit 2s linear infinite;
    filter: drop-shadow(0 0 6px rgba(201, 168, 76, 0.8));
  }

  @keyframes orbit {
    from {
      transform: rotate(0deg) translateX(50px) rotate(0deg);
    }
    to {
      transform: rotate(360deg) translateX(50px) rotate(-360deg);
    }
  }

  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.6;
    }
    50% {
      transform: scale(1.1);
      opacity: 1;
    }
  }

  /* Text */
  .text {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 2px;
    animation: fade 1.5s infinite;
  }

  @keyframes fade {
    0%,
    100% {
      opacity: 0.4;
    }
    50% {
      opacity: 1;
    }
  }
</style>

<script>
  import "../scripts/loader";
</script>
