<section class="py-28 bg-white">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">

    <!-- Header -->
    <div class="text-center mb-20 max-w-3xl mx-auto">
      <span class="text-[#C9A24D] uppercase tracking-[4px] text-sm font-semibold">
        Cruise Routes
      </span>

      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mt-4 leading-tight">
        Explore Our Luxor & Aswan Nile Cruises
      </h2>

      <p class="text-gray-500 mt-6 text-lg">
        Choose your ideal itinerary and experience Egypt’s ancient wonders in luxury.
      </p>
    </div>

    <!-- Timeline / Routes -->
    <div class="relative max-w-5xl mx-auto">

      <!-- Vertical Line -->
      <div class="absolute left-1/2 transform -translate-x-1/2 h-full w-1 bg-gray-200"></div>

      <!-- Route Items -->
      <div class="space-y-16">

        <!-- Route 1 -->
        <div class="flex flex-col lg:flex-row items-center gap-8 relative">
          <div class="lg:w-1/2 lg:pr-12 text-right lg:text-right">
            <h3 class="text-2xl font-bold text-gray-900">Day 1: Departure from Luxor</h3>
            <p class="mt-3 text-gray-500 text-lg">
              Board the cruise ship and enjoy a welcome dinner on the Nile while sailing past Luxor’s scenic views.
            </p>
          </div>
          <div class="lg:w-1/2 flex justify-center">
            <img src="/images/luxor-temple.webp" alt="Luxor Temple view from Nile Cruise" class="w-full h-64 object-cover rounded-3xl shadow-lg" loading="lazy">
          </div>
          <!-- Dot -->
          <div class="absolute left-1/2 -translate-x-1/2 bg-[#C9A24D] w-6 h-6 rounded-full border-4 border-white shadow-lg"></div>
        </div>

        <!-- Route 2 -->
        <div class="flex flex-col lg:flex-row-reverse items-center gap-8 relative">
          <div class="lg:w-1/2 lg:pl-12 text-left">
            <h3 class="text-2xl font-bold text-gray-900">Day 2: Edfu & Kom Ombo Temples</h3>
            <p class="mt-3 text-gray-500 text-lg">
              Visit Edfu Temple, then sail to Kom Ombo to explore its unique twin temples, all in luxury comfort.
            </p>
          </div>
          <div class="lg:w-1/2 flex justify-center">
            <img src="/images/edfou-temple.webp" alt="Edfu Temple from Nile Cruise" class="w-full h-64 object-cover rounded-3xl shadow-lg" loading="lazy">
          </div>
          <div class="absolute left-1/2 -translate-x-1/2 bg-[#C9A24D] w-6 h-6 rounded-full border-4 border-white shadow-lg"></div>
        </div>

        <!-- Route 3 -->
        <div class="flex flex-col lg:flex-row items-center gap-8 relative">
          <div class="lg:w-1/2 lg:pr-12 text-right lg:text-right">
            <h3 class="text-2xl font-bold text-gray-900">Day 3: Aswan & Philae Temple</h3>
            <p class="mt-3 text-gray-500 text-lg">
              Explore Aswan, visit the Philae Temple, and enjoy sunset views from the deck with dinner on board.
            </p>
          </div>
          <div class="lg:w-1/2 flex justify-center">
            <img src="/images/philae-temple.webp" alt="Philae Temple view from Nile Cruise" class="w-full h-64 object-cover rounded-3xl shadow-lg" loading="lazy">
          </div>
          <div class="absolute left-1/2 -translate-x-1/2 bg-[#C9A24D] w-6 h-6 rounded-full border-4 border-white shadow-lg"></div>
        </div>

        <!-- Route 4 -->
        <div class="flex flex-col lg:flex-row-reverse items-center gap-8 relative">
          <div class="lg:w-1/2 lg:pl-12 text-left">
            <h3 class="text-2xl font-bold text-gray-900">Day 4: Return & Departure</h3>
            <p class="mt-3 text-gray-500 text-lg">
              Enjoy breakfast on deck and disembark at Luxor or Aswan, concluding a memorable Nile cruise journey.
            </p>
          </div>
          <div class="lg:w-1/2 flex justify-center">
            <img src="/images/aswan-cruise.webp" alt="Aswan Nile Cruise View" class="w-full h-64 object-cover rounded-3xl shadow-lg" loading="lazy">
          </div>
          <div class="absolute left-1/2 -translate-x-1/2 bg-[#C9A24D] w-6 h-6 rounded-full border-4 border-white shadow-lg"></div>
        </div>

      </div>
    </div>

  </div>
</section>