<section class="py-24 px-6 lg:px-20 bg-[#F8F5EF]">
  <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-12 items-center">
    <!-- Google Map Card -->
    <div class="h-[400px] w-full rounded-3xl overflow-hidden shadow-2xl">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m17!1m12!1m3!1d3453.657786647716!2d31.23919397555391!3d30.046674174922515!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m2!1m1!2zMzDCsDAyJzQ4LjAiTiAzMcKwMTQnMzAuNCJF!5e0!3m2!1sen!2seg!4v1777231372405!5m2!1sen!2seg"
        class="w-full h-full border-0"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>

    <!-- Contact Form Card -->
    <div class="bg-white rounded-3xl shadow-2xl p-10 md:p-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-8">
        How We Can Help
      </h2>

      <!-- Success Message -->
      <div
        id="success-msg"
        class="hidden mb-6 p-4 bg-green-100 text-green-800 rounded-xl text-center font-medium"
      >
        ✅ Your message has been sent successfully! We'll get back to you soon.
      </div>

      <!-- Error Message -->
      <div
        id="error-msg"
        class="hidden mb-6 p-4 bg-red-100 text-red-800 rounded-xl text-center font-medium"
      >
        ❌ Something went wrong. Please try again.
      </div>

      <form id="contact-form" class="grid gap-6">
        <!-- Name -->
        <div class="grid md:grid-cols-2 gap-6">
          <input
            type="text"
            id="firstName"
            placeholder="First Name"
            required
            class="border border-gray-300 rounded-xl px-5 py-4 focus:ring-2 focus:ring-[#C8A976] outline-none text-gray-700"
          />
          <input
            type="text"
            id="lastName"
            placeholder="Last Name"
            required
            class="border border-gray-300 rounded-xl px-5 py-4 focus:ring-2 focus:ring-[#C8A976] outline-none text-gray-700"
          />
        </div>

        <!-- Email & Subject -->
        <div class="grid md:grid-cols-2 gap-6">
          <input
            type="email"
            id="email"
            placeholder="Email"
            required
            class="border border-gray-300 rounded-xl px-5 py-4 focus:ring-2 focus:ring-[#C8A976] outline-none text-gray-700"
          />
          <input
            type="text"
            id="subject"
            placeholder="Subject"
            required
            class="border border-gray-300 rounded-xl px-5 py-4 focus:ring-2 focus:ring-[#C8A976] outline-none text-gray-700"
          />
        </div>

        <!-- Message -->
        <textarea
          id="message"
          rows="6"
          placeholder="Message"
          required
          class="border border-gray-300 rounded-xl px-5 py-4 focus:ring-2 focus:ring-[#C8A976] outline-none text-gray-700"
        ></textarea>

        <!-- Submit Button -->
        <button
          type="submit"
          id="submit-btn"
          class="bg-[#C8A976] text-white py-4 rounded-2xl font-semibold w-full text-lg transition-opacity duration-200"
        >
          Send Message
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  import "../../scripts/contact-form";
</script>
