<!-- Itinerary Dubai -->
<section class="py-24 bg-[#f8f8f8]">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <div class="text-center mb-20">
      <span class="text-sm tracking-[4px] text-[#C9A24D] font-semibold uppercase">Suggested Itinerary</span>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-3">Discover the Best of Dubai</h2>
      <p class="text-gray-500 mt-4 max-w-2xl mx-auto leading-relaxed">A perfectly planned journey through Dubai's most iconic landmarks and unforgettable experiences.</p>
    </div>
    <div class="relative">
      <div class="hidden lg:block absolute left-1/2 top-0 h-full w-[2px] bg-[#C9A24D]/30 -translate-x-1/2"></div>
      <div class="space-y-16">
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img src="/images/burj-khalifa.webp" alt="Burj Khalifa" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">1</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Morning</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Burj Khalifa</h3>
            <p class="text-gray-600 leading-relaxed">Start with the world's tallest building — visit the At The Top observation deck for stunning sunrise views over the city.</p>
          </div>
        </div>
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">2</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Afternoon</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Dubai Mall & Fountain</h3>
            <p class="text-gray-600 leading-relaxed">Explore the massive Dubai Mall, watch the famous dancing fountain show, and enjoy lunch at one of the waterfront restaurants.</p>
          </div>
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img src="/images/dubai-mall.webp" alt="Dubai Mall & Fountain" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
        </div>
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img src="/images/dubai-souk.webp" alt="Gold & Spice Souks" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">3</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Late Afternoon</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Gold & Spice Souks</h3>
            <p class="text-gray-600 leading-relaxed">Head to Old Dubai and explore the vibrant traditional souks — haggle for gold, spices, and authentic Arabian souvenirs.</p>
          </div>
        </div>
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">4</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Sunset</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Dubai Creek Abra</h3>
            <p class="text-gray-600 leading-relaxed">Take a traditional abra boat ride across Dubai Creek as the sun sets over the historic waterway.</p>
          </div>
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img src="/images/dubai-creek.webp" alt="Dubai Creek Abra" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
        </div>
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img src="/images/desert-safari.webp" alt="Desert Safari" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">5</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Evening</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Desert Safari</h3>
            <p class="text-gray-600 leading-relaxed">End your day with a thrilling desert safari including dune bashing, camel riding, and a Bedouin dinner under the stars.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
