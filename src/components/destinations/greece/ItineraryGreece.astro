<!-- Itinerary Greece -->
<section class="py-24 bg-[#f8f8f8]">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <div class="text-center mb-20">
      <span class="text-sm tracking-[4px] text-[#C9A24D] font-semibold uppercase">Suggested Itinerary</span>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-3">Discover the Best of Greece</h2>
      <p class="text-gray-500 mt-4 max-w-2xl mx-auto leading-relaxed">A perfectly planned journey through Greece's most iconic landmarks and unforgettable experiences.</p>
    </div>
    <div class="relative">
      <div class="hidden lg:block absolute left-1/2 top-0 h-full w-[2px] bg-[#C9A24D]/30 -translate-x-1/2"></div>
      <div class="space-y-16">
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img src="/images/acropolis.webp" alt="Acropolis of Athens" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">1</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Morning</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Acropolis of Athens</h3>
            <p class="text-gray-600 leading-relaxed">Start at the iconic Acropolis and Parthenon — the symbol of ancient Greek civilization and democracy.</p>
          </div>
        </div>
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">2</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Afternoon</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Athens Old Town (Plaka)</h3>
            <p class="text-gray-600 leading-relaxed">Wander through the charming Plaka neighborhood, explore local shops, and enjoy authentic Greek mezze.</p>
          </div>
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img src="/images/athens-plaka.webp" alt="Athens Old Town (Plaka)" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
        </div>
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img src="/images/santorini.webp" alt="Santorini Arrival" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">3</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Day 2 Morning</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Santorini Arrival</h3>
            <p class="text-gray-600 leading-relaxed">Fly or ferry to Santorini and explore the iconic white-washed villages of Oia and Fira.</p>
          </div>
        </div>
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">4</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Afternoon</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Caldera Views</h3>
            <p class="text-gray-600 leading-relaxed">Take a boat tour of the volcanic caldera and enjoy swimming in the warm Aegean waters.</p>
          </div>
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img src="/images/santorini-caldera.webp" alt="Caldera Views" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
        </div>
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img src="/images/oia-sunset.webp" alt="Oia Sunset" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">5</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Sunset</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Oia Sunset</h3>
            <p class="text-gray-600 leading-relaxed">Watch the world-famous sunset from Oia — one of the most beautiful moments you will ever witness.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
