<!-- Attractions Sharm El Sheikh -->
<section class="py-24 bg-[#f8f8f8]">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <!-- Heading -->
    <div class="text-center mb-16">
      <span
        class="text-sm tracking-[4px] text-[#C9A24D] font-semibold uppercase"
      >
        Top Attractions
      </span>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-3">
        Places to Visit in Sharm El Sheikh
      </h2>
      <p class="text-gray-600 mt-4 max-w-2xl mx-auto">
        Discover the most famous attractions and natural wonders that make Sharm
        El Sheikh one of the top travel destinations in the Red Sea.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Ras Mohammed -->
      <div
        class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300"
      >
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/ras-mohamed.webp"
            alt="Ras Mohammed National Park"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">
            Ras Mohammed National Park
          </h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            Egypt's most famous marine reserve, known for its crystal waters,
            coral reefs, and world-class diving spots.
          </p>
        </div>
      </div>

      <!-- Naama Bay -->
      <div
        class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300"
      >
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/naama-bay.webp"
            alt="Naama Bay Sharm El Sheikh"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Naama Bay</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            The vibrant heart of Sharm El Sheikh filled with restaurants, cafés,
            beaches, and lively nightlife.
          </p>
        </div>
      </div>

      <!-- SOHO Square -->
      <div
        class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300"
      >
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/soho-square.webp"
            alt="SOHO Square Sharm El Sheikh"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">SOHO Square</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            A modern entertainment hub featuring shopping, restaurants, shows,
            and family attractions.
          </p>
        </div>
      </div>

      <!-- Tiran Island -->
      <div
        class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300"
      >
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/tiran-island.webp"
            alt="Tiran Island Red Sea"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Tiran Island</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            A paradise for snorkeling and diving with colorful coral reefs and
            rich marine life.
          </p>
        </div>
      </div>

      <!-- Mount Sinai -->
      <div
        class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300"
      >
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/mount-sinai.webp"
            alt="Mount Sinai sunrise hike"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Mount Sinai</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            A historic mountain famous for sunrise hikes and breathtaking
            panoramic views of Sinai.
          </p>
        </div>
      </div>

      <!-- St Catherine Monastery -->
      <div
        class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300"
      >
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/st-catherine.webp"
            alt="St Catherine Monastery UNESCO"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">
            St Catherine Monastery
          </h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            One of the oldest Christian monasteries in the world and a UNESCO
            World Heritage site.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
