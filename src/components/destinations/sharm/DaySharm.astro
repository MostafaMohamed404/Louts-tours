<!-- Day Sharm - Suggested Experiences -->
<section class="py-24 bg-[#f8f8f8]">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">

    <!-- Title -->
    <div class="text-center mb-20">
      <span class="text-sm tracking-[4px] text-[#C9A24D] font-semibold uppercase">
        Suggested Experiences
      </span>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-3">
        Discover the Best of Sharm El Sheikh
      </h2>
      <p class="text-gray-500 mt-4 max-w-2xl mx-auto leading-relaxed">
        From breathtaking coral reefs and crystal-clear waters to sacred
        mountains and vibrant nightlife, Sharm El Sheikh offers unforgettable
        experiences for every traveler.
      </p>
    </div>

    <!-- Timeline -->
    <div class="relative">

      <!-- Center Line -->
      <div class="hidden lg:block absolute left-1/2 top-0 h-full w-[2px] bg-[#C9A24D]/30 -translate-x-1/2"></div>

      <div class="space-y-16">

        <!-- Stop 1: Ras Mohammed -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img
              src="/images/ras-mohamed.webp"
              alt="Ras Mohamed National Park"
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">1</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Half Day</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Ras Mohammed National Park</h3>
            <p class="text-gray-600 leading-relaxed">
              Explore one of Egypt's most spectacular marine reserves,
              famous for vibrant coral reefs, diverse marine life, and
              crystal-clear waters perfect for snorkeling and diving.
            </p>
          </div>
        </div>

        <!-- Stop 2: Tiran Island -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">2</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Boat Trip</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Tiran Island</h3>
            <p class="text-gray-600 leading-relaxed">
              Enjoy a relaxing boat excursion to Tiran Island where you
              can swim, snorkel, and discover the stunning underwater
              world of the Red Sea.
            </p>
          </div>
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img
              src="/images/tiran-island.webp"
              alt="Tiran Island Red Sea"
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
        </div>

        <!-- Stop 3: Mount Sinai -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img
              src="/images/mount-sinai.webp"
              alt="Mount Sinai sunrise"
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">3</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Sunrise Hike</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Mount Sinai</h3>
            <p class="text-gray-600 leading-relaxed">
              Climb the legendary mountain at dawn and witness one of the
              most breathtaking sunrise views across the Sinai desert.
            </p>
          </div>
        </div>

        <!-- Stop 4: St Catherine -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">4</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Historic Visit</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">St. Catherine Monastery</h3>
            <p class="text-gray-600 leading-relaxed">
              Visit one of the oldest Christian monasteries in the world,
              located at the foot of Mount Sinai and rich with religious
              history and priceless manuscripts.
            </p>
          </div>
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img
              src="/images/st-catherine.webp"
              alt="St Catherine Monastery"
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
        </div>

        <!-- Stop 5: SOHO Square -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img
              src="/images/soho-square.webp"
              alt="SOHO Square Sharm"
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">5</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Evening</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">SOHO Square</h3>
            <p class="text-gray-600 leading-relaxed">
              Experience Sharm's vibrant nightlife with restaurants,
              cafés, live shows, and entertainment in the lively
              SOHO Square district.
            </p>
          </div>
        </div>

        <!-- Stop 6: Naama Bay -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">6</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Night Walk</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Naama Bay</h3>
            <p class="text-gray-600 leading-relaxed">
              Stroll along the famous Naama Bay promenade filled with
              restaurants, shops, beach cafés, and stunning views of
              the Red Sea at night.
            </p>
          </div>
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img
              src="/images/naama-bay.webp"
              alt="Naama Bay night"
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
        </div>

      </div>
    </div>
  </div>
</section>