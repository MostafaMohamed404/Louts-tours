<!-- Attractions Mongolia -->
<section class="py-24 bg-[#f8f8f8]">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <div class="text-center mb-16">
      <span class="text-sm tracking-[4px] text-[#C9A24D] font-semibold uppercase">Top Attractions</span>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-3">Best Places to Visit in Mongolia</h2>
      <p class="text-gray-600 mt-4 max-w-2xl mx-auto">Discover the most iconic landmarks and natural wonders that make Mongolia one of the world's most unforgettable destinations.</p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300">
        <div class="overflow-hidden h-[220px]">
          <img src="/images/gobi-desert.webp" alt="Gobi Desert Mongolia" class="w-full h-full object-cover hover:scale-105 transition duration-500" loading="lazy"/>
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Gobi Desert</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">One of the world's great deserts, featuring dramatic sand dunes, ancient fossil sites, and stunning rock formations.</p>
        </div>
      </div>
      <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300">
        <div class="overflow-hidden h-[220px]">
          <img src="/images/ulaanbaatar.webp" alt="Ulaanbaatar Mongolia" class="w-full h-full object-cover hover:scale-105 transition duration-500" loading="lazy"/>
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Ulaanbaatar</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">Mongolia's capital city blending Soviet architecture, Buddhist monasteries, and a vibrant modern arts scene.</p>
        </div>
      </div>
      <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300">
        <div class="overflow-hidden h-[220px]">
          <img src="/images/terelj.webp" alt="Terelj National Park Mongolia" class="w-full h-full object-cover hover:scale-105 transition duration-500" loading="lazy"/>
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Terelj National Park</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">A stunning national park near the capital featuring granite rock formations, river valleys, and nomadic ger camps.</p>
        </div>
      </div>
      <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300">
        <div class="overflow-hidden h-[220px]">
          <img src="/images/khustai.webp" alt="Khustai National Park Mongolia" class="w-full h-full object-cover hover:scale-105 transition duration-500" loading="lazy"/>
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Khustai National Park</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">Home to the world's last truly wild horses — the Przewalski horse — roaming free on the open steppe.</p>
        </div>
      </div>
      <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300">
        <div class="overflow-hidden h-[220px]">
          <img src="/images/erdene-zuu.webp" alt="Erdene Zuu Monastery Mongolia" class="w-full h-full object-cover hover:scale-105 transition duration-500" loading="lazy"/>
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Erdene Zuu Monastery</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">Mongolia's oldest Buddhist monastery built within the ruins of ancient Karakorum, the capital of the Mongol Empire.</p>
        </div>
      </div>
      <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300">
        <div class="overflow-hidden h-[220px]">
          <img src="/images/white-black-desert.webp" alt="White & Black Desert Mongolia" class="w-full h-full object-cover hover:scale-105 transition duration-500" loading="lazy"/>
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">White & Black Desert</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">The otherworldly White Desert of chalk formations and the volcanic Black Desert — nature at its most dramatic.</p>
        </div>
      </div>
    </div>
  </div>
