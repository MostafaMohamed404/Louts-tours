<!-- Attractions Aswan -->
<section class="py-24 bg-[#f8f8f8]">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <!-- Heading -->
    <div class="text-center mb-16">
      <span
        class="text-sm tracking-[4px] text-[#C9A24D] font-semibold uppercase"
      >
        Top Attractions
      </span>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-3">
        Places to Visit in Aswan
      </h2>
      <p class="text-gray-600 mt-4 max-w-2xl mx-auto">
        Explore the ancient temples, Nile islands, and cultural landmarks that
        make Aswan one of Egypt's most fascinating destinations.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Philae Temple -->
      <div
        class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300"
      >
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/philae-temple.webp"
            alt="Philae Temple Aswan Egypt"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Philae Temple</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            A beautiful island temple dedicated to the goddess Isis and one of
            the most iconic landmarks along the Nile in Aswan.
          </p>
        </div>
      </div>

      <!-- Abu Simbel -->
      <div
        class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300"
      >
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/abu-simbel.webp"
            alt="Abu Simbel Temples Ramses II"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Abu Simbel</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            Magnificent rock temples built by Ramses II, famous for their giant
            statues and incredible ancient architecture.
          </p>
        </div>
      </div>

      <!-- Aswan High Dam -->
      <div
        class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300"
      >
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/aswan-high-dam.webp"
            alt="Aswan High Dam Lake Nasser"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Aswan High Dam</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            A massive engineering project that controls the Nile floods and
            created the vast Lake Nasser.
          </p>
        </div>
      </div>

      <!-- Unfinished Obelisk -->
      <div
        class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300"
      >
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/unfinished-obelisk.webp"
            alt="Unfinished Obelisk Aswan granite quarry"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">
            Unfinished Obelisk
          </h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            An enormous ancient obelisk still lying in the granite quarry,
            revealing how the Egyptians carved their monuments.
          </p>
        </div>
      </div>

      <!-- Elephantine Island -->
      <div
        class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300"
      >
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/elephantine-island.webp"
            alt="Elephantine Island Nile Aswan"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">
            Elephantine Island
          </h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            A historic Nile island featuring ancient ruins, temples, and scenic
            views of the river.
          </p>
        </div>
      </div>

      <!-- Nubian Village -->
      <div
        class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300"
      >
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/nubian-village.webp"
            alt="Nubian Village colorful culture Aswan"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Nubian Village</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            A colorful traditional village where visitors experience Nubian
            culture, crafts, and warm hospitality.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
