<!-- Day Aswan - Suggested Itinerary -->
<section class="py-24 bg-[#f8f8f8]">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">

    <!-- Title -->
    <div class="text-center mb-20">
      <span class="text-sm tracking-[4px] text-[#C9A24D] font-semibold uppercase">
        Suggested Itinerary
      </span>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-3">
        Perfect Day in Aswan
      </h2>
      <p class="text-gray-500 mt-4 max-w-2xl mx-auto leading-relaxed">
        Enjoy a peaceful day in Aswan exploring ancient temples, Nile islands,
        and experiencing the rich Nubian culture.
      </p>
    </div>

    <!-- Timeline -->
    <div class="relative">

      <!-- Center Line -->
      <div class="hidden lg:block absolute left-1/2 top-0 h-full w-[2px] bg-[#C9A24D]/30 -translate-x-1/2"></div>

      <div class="space-y-16">

        <!-- Stop 1: Philae Temple -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img
              src="/images/philae-temple.webp"
              alt="Philae Temple Aswan"
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">1</span>
              <span class="text-[#C9A24D] font-semibold text-sm">~2 Hours</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Philae Temple</h3>
            <p class="text-gray-600 leading-relaxed">
              Start your day with a boat ride to Philae Temple, beautifully located
              on an island in the Nile and dedicated to the goddess Isis.
            </p>
          </div>
        </div>

        <!-- Stop 2: Aswan High Dam -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">2</span>
              <span class="text-[#C9A24D] font-semibold text-sm">~1.5 Hours</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Aswan High Dam</h3>
            <p class="text-gray-600 leading-relaxed">
              Visit the impressive Aswan High Dam and enjoy panoramic views of
              the vast Lake Nasser stretching into the horizon.
            </p>
          </div>
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img
              src="/images/aswan-high-dam.webp"
              alt="Aswan High Dam Lake Nasser"
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
        </div>

        <!-- Stop 3: Unfinished Obelisk -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img
              src="/images/unfinished-obelisk.webp"
              alt="Unfinished Obelisk granite quarry"
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">3</span>
              <span class="text-[#C9A24D] font-semibold text-sm">~1 Hour</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Unfinished Obelisk</h3>
            <p class="text-gray-600 leading-relaxed">
              Discover how ancient Egyptians carved massive obelisks directly
              in granite quarries — a fascinating window into their craftsmanship.
            </p>
          </div>
        </div>

        <!-- Stop 4: Elephantine Island -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">4</span>
              <span class="text-[#C9A24D] font-semibold text-sm">~2 Hours</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Elephantine Island</h3>
            <p class="text-gray-600 leading-relaxed">
              Explore ancient ruins and enjoy peaceful Nile views on this
              historic island at the heart of the river.
            </p>
          </div>
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img
              src="/images/elephantine-island.webp"
              alt="Elephantine Island Nile"
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
        </div>

        <!-- Stop 5: Nubian Village -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img
              src="/images/nubian-village.webp"
              alt="Nubian Village Aswan culture"
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">5</span>
              <span class="text-[#C9A24D] font-semibold text-sm">~2 Hours</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Nubian Village</h3>
            <p class="text-gray-600 leading-relaxed">
              End your day with a visit to a colorful Nubian village and experience
              local culture, traditional crafts, and warm hospitality.
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>