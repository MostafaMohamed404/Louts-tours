<!-- Things To Do Aswan -->
<section class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6 lg:px-16">
    <!-- Title -->
    <div class="max-w-2xl mb-16">
      <span
        class="text-[#C9A24D] uppercase tracking-[4px] text-sm font-semibold"
      >
        Experiences
      </span>
      <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mt-4">
        Things To Do in Aswan
      </h2>
      <p class="text-gray-600 mt-6 leading-relaxed">
        Discover the charm of Aswan with its serene Nile views, ancient temples,
        rich Nubian culture, and unique historical landmarks in southern Egypt.
      </p>
    </div>

    <!-- Layout -->
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Image -->
      <div class="relative">
        <img
          src="/images/philae-temple.webp"
          alt="Philae Temple top experience Aswan"
          class="rounded-3xl object-cover w-full h-[520px]"
          loading="lazy"
        />
        <div
          class="absolute bottom-6 left-6 bg-white/90 backdrop-blur rounded-xl px-6 py-4 shadow-lg"
        >
          <p class="text-sm text-gray-500">Top Experience</p>
          <h4 class="font-semibold text-gray-900">Philae Temple</h4>
        </div>
      </div>

      <!-- Activities Grid -->
      <div class="grid sm:grid-cols-2 gap-6">
        <div
          class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden"
        >
          <div
            class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"
          >
          </div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">
            Philae Temple
          </h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Visit the beautiful island temple dedicated to Isis, surrounded by
            the waters of the Nile.
          </p>
        </div>

        <div
          class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden"
        >
          <div
            class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"
          >
          </div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">Abu Simbel</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Explore the iconic temples of Ramses II carved into the mountains,
            one of Egypt's greatest wonders.
          </p>
        </div>

        <div
          class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden"
        >
          <div
            class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"
          >
          </div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">
            Aswan High Dam
          </h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Discover the engineering marvel that controls the Nile and created
            Lake Nasser.
          </p>
        </div>

        <div
          class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden"
        >
          <div
            class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"
          >
          </div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">
            Unfinished Obelisk
          </h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            See the largest known ancient obelisk, still lying in the granite
            quarry.
          </p>
        </div>

        <div
          class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden"
        >
          <div
            class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"
          >
          </div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">
            Elephantine Island
          </h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Explore a historic island with ancient ruins and beautiful Nile
            scenery.
          </p>
        </div>

        <div
          class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden"
        >
          <div
            class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"
          >
          </div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">
            Nubian Village
          </h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Experience colorful houses, local culture, and warm hospitality in a
            traditional Nubian village.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
