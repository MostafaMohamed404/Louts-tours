<!-- Itinerary Malaysia -->
<section class="py-24 bg-[#f8f8f8]">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <div class="text-center mb-20">
      <span class="text-sm tracking-[4px] text-[#C9A24D] font-semibold uppercase">Suggested Itinerary</span>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-3">Discover the Best of Malaysia</h2>
      <p class="text-gray-500 mt-4 max-w-2xl mx-auto leading-relaxed">A perfectly planned journey through Malaysia's most iconic landmarks and unforgettable experiences.</p>
    </div>
    <div class="relative">
      <div class="hidden lg:block absolute left-1/2 top-0 h-full w-[2px] bg-[#C9A24D]/30 -translate-x-1/2"></div>
      <div class="space-y-16">
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img src="/images/petronas.webp" alt="Petronas Twin Towers" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">1</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Morning</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Petronas Twin Towers</h3>
            <p class="text-gray-600 leading-relaxed">Start at the iconic Petronas Towers — visit the sky bridge and observation deck for panoramic KL views.</p>
          </div>
        </div>
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">2</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Afternoon</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Batu Caves</h3>
            <p class="text-gray-600 leading-relaxed">Head to the spectacular Batu Caves and climb the colorful steps to the stunning Hindu temple complex.</p>
          </div>
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img src="/images/batu-caves.webp" alt="Batu Caves" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
        </div>
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img src="/images/penang.webp" alt="Penang George Town" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">3</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Day 2</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Penang George Town</h3>
            <p class="text-gray-600 leading-relaxed">Explore the UNESCO heritage city — discover colonial buildings, vibrant street art, and the best street food in Asia.</p>
          </div>
        </div>
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">4</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Day 3</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Langkawi Island</h3>
            <p class="text-gray-600 leading-relaxed">Fly to Langkawi and spend the day relaxing on pristine beaches and exploring the island's natural beauty.</p>
          </div>
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img src="/images/langkawi.webp" alt="Langkawi Island" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
        </div>
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img src="/images/cameron-highlands.webp" alt="Cameron Highlands" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">5</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Final Day</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Cameron Highlands</h3>
            <p class="text-gray-600 leading-relaxed">Visit the cool highland tea plantations, pick strawberries, and enjoy fresh tea surrounded by misty mountains.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
