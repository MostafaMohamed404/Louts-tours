<section class="py-24 bg-[#f8f8f8]">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">

    <!-- Title -->
    <div class="text-center mb-20">
      <span class="text-sm tracking-[4px] text-[#C9A24D] font-semibold uppercase">
        Suggested Experiences
      </span>

      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-3">
        Discover the Best of Siwa Oasis
      </h2>

      <p class="text-gray-500 mt-4 max-w-2xl mx-auto">
        Experience the peaceful charm of Siwa through ancient history,
        natural springs, desert adventures, and breathtaking landscapes.
      </p>
    </div>

    <!-- Timeline -->
    <div class="relative">

      <div class="hidden lg:block absolute left-1/2 top-0 h-full w-[2px] bg-[#C9A24D]/30"></div>

      <div class="space-y-16">

        <!-- Item 1 -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">

          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img src="/images/shali-fortress.webp"
              alt="Shali Fortress"
              loading="lazy"
              class="w-full h-full object-cover">
          </div>

          <div class="bg-white p-8 rounded-2xl shadow-md">
            <span class="text-[#C9A24D] font-semibold text-sm">Historic Walk</span>
            <h3 class="text-2xl font-bold mt-2 mb-3">Shali Fortress</h3>
            <p class="text-gray-600">
              Wander through the ancient mud-brick ruins of Shali and enjoy panoramic
              views over Siwa village.
            </p>
          </div>

        </div>

        <!-- Item 2 -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">

          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <span class="text-[#C9A24D] font-semibold text-sm">Cultural Visit</span>
            <h3 class="text-2xl font-bold mt-2 mb-3">Temple of the Oracle</h3>
            <p class="text-gray-600">
              Visit the legendary temple where Alexander the Great sought guidance
              from the oracle.
            </p>
          </div>

          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img src="/images/oracle-temple.webp"
              alt="Temple of the Oracle"
              loading="lazy"
              class="w-full h-full object-cover">
          </div>

        </div>

        <!-- Item 3 -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">

          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img src="/images/cleopatra-spring.webp"
              alt="Cleopatra Spring"
              loading="lazy"
              class="w-full h-full object-cover">
          </div>

          <div class="bg-white p-8 rounded-2xl shadow-md">
            <span class="text-[#C9A24D] font-semibold text-sm">Relaxation</span>
            <h3 class="text-2xl font-bold mt-2 mb-3">Cleopatra Spring</h3>
            <p class="text-gray-600">
              Take a refreshing dip in the famous natural spring surrounded
              by palm trees and desert scenery.
            </p>
          </div>

        </div>

        <!-- Item 4 -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">

          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <span class="text-[#C9A24D] font-semibold text-sm">Unique Experience</span>
            <h3 class="text-2xl font-bold mt-2 mb-3">Siwa Salt Lakes</h3>
            <p class="text-gray-600">
              Float effortlessly in the salt lakes and enjoy one of the most
              unique natural experiences in Egypt.
            </p>
          </div>

          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img src="/images/siwa-salt-lakes.webp"
              alt="Siwa Salt Lakes"
              loading="lazy"
              class="w-full h-full object-cover">
          </div>

        </div>

        <!-- Item 5 -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">

          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img src="/images/mountain-of-the-dead.webp"
              alt="Mountain of the Dead"
              loading="lazy"
              class="w-full h-full object-cover">
          </div>

          <div class="bg-white p-8 rounded-2xl shadow-md">
            <span class="text-[#C9A24D] font-semibold text-sm">Historic Exploration</span>
            <h3 class="text-2xl font-bold mt-2 mb-3">Mountain of the Dead</h3>
            <p class="text-gray-600">
              Explore ancient tombs carved into the mountain and uncover
              Siwa’s rich historical heritage.
            </p>
          </div>

        </div>

        <!-- Item 6 -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">

          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <span class="text-[#C9A24D] font-semibold text-sm">Desert Safari</span>
            <h3 class="text-2xl font-bold mt-2 mb-3">Great Sand Sea</h3>
            <p class="text-gray-600">
              Experience thrilling desert safari adventures, sandboarding,
              and unforgettable sunset views over the dunes.
            </p>
          </div>

          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img src="/images/great-sand-sea.webp"
              alt="Great Sand Sea"
              loading="lazy"
              class="w-full h-full object-cover">
          </div>

        </div>

      </div>

    </div>

  </div>
</section>