<!-- Itinerary Philippines -->
<section class="py-24 bg-[#f8f8f8]">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <div class="text-center mb-20">
      <span class="text-sm tracking-[4px] text-[#C9A24D] font-semibold uppercase">Suggested Itinerary</span>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-3">Discover the Best of Philippines</h2>
      <p class="text-gray-500 mt-4 max-w-2xl mx-auto leading-relaxed">A perfectly planned journey through Philippines's most iconic landmarks and unforgettable experiences.</p>
    </div>
    <div class="relative">
      <div class="hidden lg:block absolute left-1/2 top-0 h-full w-[2px] bg-[#C9A24D]/30 -translate-x-1/2"></div>
      <div class="space-y-16">
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img src="/images/intramuros.webp" alt="Manila City" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">1</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Day 1</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Manila City</h3>
            <p class="text-gray-600 leading-relaxed">Explore historic Intramuros, Rizal Park, and the vibrant neighborhoods of the Philippine capital.</p>
          </div>
        </div>
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">2</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Day 2</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Bohol Island</h3>
            <p class="text-gray-600 leading-relaxed">Visit the iconic Chocolate Hills, meet rare tarsiers, and cross the famous hanging bridges of Bohol.</p>
          </div>
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img src="/images/chocolate-hills.webp" alt="Bohol Island" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
        </div>
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img src="/images/boracay.webp" alt="Boracay Beach" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">3</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Day 3</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Boracay Beach</h3>
            <p class="text-gray-600 leading-relaxed">Fly to Boracay — spend the day on the world-famous White Beach and enjoy stunning sunset views.</p>
          </div>
        </div>
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">4</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Day 4</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">El Nido Palawan</h3>
            <p class="text-gray-600 leading-relaxed">Fly to Palawan's El Nido and embark on an island hopping tour through stunning turquoise lagoons.</p>
          </div>
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img src="/images/palawan.webp" alt="El Nido Palawan" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
        </div>
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img src="/images/underground-river.webp" alt="Underground River" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">5</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Day 5</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Underground River</h3>
            <p class="text-gray-600 leading-relaxed">Visit Puerto Princesa's world-famous Underground River — a UNESCO World Heritage site and natural wonder.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
