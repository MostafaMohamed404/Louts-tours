<!-- Things To Do White Desert -->
<section class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6 lg:px-16">

    <!-- Title -->
    <div class="max-w-2xl mb-16">
      <span class="text-[#C9A24D] uppercase tracking-[4px] text-sm font-semibold">
        Experiences
      </span>
      <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mt-4">
        Things To Do in the White Desert
      </h2>
      <p class="text-gray-600 mt-6 leading-relaxed">
        From off-road jeep adventures and desert camping to stargazing and exploring
        bizarre rock formations — the White Desert offers experiences unlike anywhere else on earth.
      </p>
    </div>

    <!-- Layout -->
    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <!-- Image -->
      <div class="relative">
        <img
          src="/images/white-desert-formations.webp"
          alt="White Desert rock formations top experience"
          class="rounded-3xl object-cover w-full h-[520px]"
          loading="lazy"
        />
        <div class="absolute bottom-6 left-6 bg-white/90 backdrop-blur rounded-xl px-6 py-4 shadow-lg">
          <p class="text-sm text-gray-500">Top Experience</p>
          <h4 class="font-semibold text-gray-900">White Desert Camping</h4>
        </div>
      </div>

      <!-- Activities Grid -->
      <div class="grid sm:grid-cols-2 gap-6">

        <div class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"></div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">4x4 Desert Safari</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Ride through dramatic desert landscapes in a comfortable 4x4 jeep with an experienced local guide.
          </p>
        </div>

        <div class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"></div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">Stargazing</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Experience the clearest night sky you've ever seen, far from any city light pollution.
          </p>
        </div>

        <div class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"></div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">Rock Formation Hike</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Explore the famous chalk sculptures — the Mushroom, Chicken, and Rabbit formations up close.
          </p>
        </div>

        <div class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"></div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">Desert Campfire</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Gather around a traditional campfire for BBQ dinner and tea in the heart of the desert.
          </p>
        </div>

        <div class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"></div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">Crystal Mountain Visit</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Stop at the sparkling Crystal Mountain arch — one of Egypt's most unique geological wonders.
          </p>
        </div>

        <div class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"></div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">Sunrise Photography</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Capture the golden sunrise turning white rock formations into glowing sculptures — pure magic.
          </p>
        </div>

      </div>
    </div>
  </div>
</section>
