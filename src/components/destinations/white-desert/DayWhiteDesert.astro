<!-- Day White Desert - 2-Day Itinerary -->
<section class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <!-- Title -->
    <div class="text-center mb-20">
      <span
        class="text-sm tracking-[4px] text-[#C9A24D] font-semibold uppercase"
      >
        2-Day Itinerary
      </span>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-3">
        Your White Desert Adventure
      </h2>
      <p class="text-gray-500 mt-4 max-w-2xl mx-auto leading-relaxed">
        Two unforgettable days exploring the volcanic Black Desert, the surreal
        White Desert, and sleeping under a blanket of stars far from city
        lights.
      </p>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Center Line -->
      <div
        class="hidden lg:block absolute left-1/2 top-0 h-full w-[2px] bg-[#C9A24D]/30 -translate-x-1/2"
      >
      </div>

      <div class="space-y-16">
        <!-- DAY 1 HEADER -->
        <div class="text-center relative z-10">
          <span
            class="inline-block bg-[#C9A24D] text-white px-8 py-2 rounded-full font-bold text-lg shadow-lg"
          >
            Day 1
          </span>
        </div>

        <!-- Stop 1: Departure & Bahariya -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img
              src="/images/bahariya-oasis.webp"
              alt="Bahariya Oasis Egypt"
              loading="lazy"
              width="640"
              height="320"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
          <div class="bg-[#f8f8f8] p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span
                class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center"
                >1</span
              >
              <span class="text-[#C9A24D] font-semibold text-sm"
                >Morning — ~3 hrs drive from Cairo</span
              >
            </div>
            <h3 class="text-2xl font-bold mb-3">Departure & Bahariya Oasis</h3>
            <p class="text-gray-600 leading-relaxed">
              Early morning departure from Cairo by 4x4. Arrive at Bahariya
              Oasis for lunch and a visit to the Valley of the Golden Mummies
              and the local market before heading into the desert.
            </p>
          </div>
        </div>

        <!-- Stop 2: Black Desert -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div
            class="bg-[#f8f8f8] p-8 rounded-2xl shadow-md order-2 lg:order-1"
          >
            <div class="flex items-center gap-3 mb-3">
              <span
                class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center"
                >2</span
              >
              <span class="text-[#C9A24D] font-semibold text-sm">Afternoon</span
              >
            </div>
            <h3 class="text-2xl font-bold mb-3">
              Black Desert & Crystal Mountain
            </h3>
            <p class="text-gray-600 leading-relaxed">
              Drive through the dramatic Black Desert with its volcanic
              mountains, then stop at the dazzling Crystal Mountain — a natural
              arch embedded with sparkling crystals.
            </p>
          </div>
          <div
            class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2"
          >
            <img
              src="/images/black-desert.webp"
              alt="Black Desert Egypt"
              loading="lazy"
              width="640"
              height="320"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
        </div>

        <!-- Stop 3: White Desert Camp -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img
              src="/images/desert-camping.webp"
              alt="Camping White Desert Egypt"
              loading="lazy"
              width="640"
              height="320"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
          <div class="bg-[#f8f8f8] p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span
                class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center"
                >3</span
              >
              <span class="text-[#C9A24D] font-semibold text-sm"
                >Evening & Night</span
              >
            </div>
            <h3 class="text-2xl font-bold mb-3">
              White Desert Camp & Stargazing
            </h3>
            <p class="text-gray-600 leading-relaxed">
              Arrive at the White Desert as the sun sets over the chalk
              formations. Enjoy a traditional BBQ dinner around the campfire and
              sleep under one of the clearest starry skies you'll ever see.
            </p>
          </div>
        </div>

        <!-- DAY 2 HEADER -->
        <div class="text-center relative z-10">
          <span
            class="inline-block bg-[#C9A24D] text-white px-8 py-2 rounded-full font-bold text-lg shadow-lg"
          >
            Day 2
          </span>
        </div>

        <!-- Stop 4: Sunrise & Formations -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div
            class="bg-[#f8f8f8] p-8 rounded-2xl shadow-md order-2 lg:order-1"
          >
            <div class="flex items-center gap-3 mb-3">
              <span
                class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center"
                >4</span
              >
              <span class="text-[#C9A24D] font-semibold text-sm"
                >Early Morning</span
              >
            </div>
            <h3 class="text-2xl font-bold mb-3">Sunrise in the White Desert</h3>
            <p class="text-gray-600 leading-relaxed">
              Wake up to a magical desert sunrise turning the white rocks
              golden. Explore the famous rock formations — the Mushroom, the
              Chicken, and the Rabbit — in the soft morning light.
            </p>
          </div>
          <div
            class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2"
          >
            <img
              src="/images/white-desert-formations.webp"
              alt="White Desert formations sunrise"
              loading="lazy"
              width="640"
              height="320"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
        </div>

        <!-- Stop 5: Return -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img
              src="/images/agabat-valley.webp"
              alt="Agabat Valley White Desert"
              loading="lazy"
              width="640"
              height="320"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
          <div class="bg-[#f8f8f8] p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span
                class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center"
                >5</span
              >
              <span class="text-[#C9A24D] font-semibold text-sm"
                >Morning & Return</span
              >
            </div>
            <h3 class="text-2xl font-bold mb-3">
              Agabat Valley & Return to Cairo
            </h3>
            <p class="text-gray-600 leading-relaxed">
              Visit the stunning Agabat Valley before heading back to Bahariya
              for lunch. Then return to Cairo by afternoon, full of memories and
              breathtaking photos.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
