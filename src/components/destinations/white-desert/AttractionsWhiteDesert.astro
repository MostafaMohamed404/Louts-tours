<!-- Attractions White Desert -->
<section class="py-24 bg-[#f8f8f8]">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">

    <!-- Heading -->
    <div class="text-center mb-16">
      <span class="text-sm tracking-[4px] text-[#C9A24D] font-semibold uppercase">
        Top Attractions
      </span>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-3">
        Places You'll Visit
      </h2>
      <p class="text-gray-600 mt-4 max-w-2xl mx-auto">
        From surreal white rock formations to volcanic black mountains and crystal-clear springs —
        every stop on this safari is unlike anything you've seen before.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">

      <!-- White Desert -->
      <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300">
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/white-desert-formations.webp"
            alt="White Desert Rock Formations Egypt"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">White Desert (Sahara el Beyda)</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            Iconic chalk-white rock formations sculpted by wind over thousands of years —
            a truly otherworldly landscape perfect for camping under the stars.
          </p>
        </div>
      </div>

      <!-- Black Desert -->
      <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300">
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/black-desert.webp"
            alt="Black Desert Egypt volcanic landscape"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Black Desert</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            A dramatic landscape of black volcanic mountains and dark basalt rocks,
            a striking contrast to the white desert nearby.
          </p>
        </div>
      </div>

      <!-- Bahariya Oasis -->
      <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300">
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/bahariya-oasis.webp"
            alt="Bahariya Oasis Egypt"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Bahariya Oasis</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            A lush green oasis in the middle of the desert, featuring hot springs,
            palm groves, and the famous Valley of the Golden Mummies.
          </p>
        </div>
      </div>

      <!-- Crystal Mountain -->
      <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300">
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/crystal-mountain.webp"
            alt="Crystal Mountain White Desert Egypt"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Crystal Mountain</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            A unique rock arch embedded with calcite crystals that sparkle in the sunlight —
            one of the most photographed spots in the Western Desert.
          </p>
        </div>
      </div>

      <!-- Agabat Valley -->
      <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300">
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/agabat-valley.webp"
            alt="Agabat Valley White Desert Egypt"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Agabat Valley</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            A hidden valley of stunning white and yellow rock formations rising dramatically
            from the desert floor, perfect for exploration.
          </p>
        </div>
      </div>

      <!-- Desert Camping -->
      <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300">
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/desert-camping.webp"
            alt="Desert Camping starry night Egypt"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Overnight Desert Camping</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            Sleep under millions of stars in the middle of the White Desert —
            campfire, traditional food, and total silence make this a night to remember.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
