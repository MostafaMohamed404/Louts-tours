<section class="py-24 bg-[#f8f8f8]">
  <div class="max-w-7xl mx-auto px-6 lg:px-16">
    <!-- Title -->
    <div class="max-w-2xl mb-16">
      <span
        class="text-[#C9A24D] uppercase tracking-[4px] text-sm font-semibold"
      >
        Experiences
      </span>

      <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mt-4">
        Things To Do in Luxor
      </h2>

      <p class="text-gray-600 mt-6">
        Step into the heart of ancient Egypt in Luxor, where timeless temples,
        royal tombs, and breathtaking Nile views create an unforgettable journey
        through history.
      </p>
    </div>

    <!-- Layout -->
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Image -->
      <div class="relative">
        <img
          src="/images/karnak-temple.webp"
          class="rounded-3xl object-cover w-full h-[520px]"
        />

        <div
          class="absolute bottom-6 left-6 bg-white/90 backdrop-blur rounded-xl px-6 py-4 shadow-lg"
        >
          <p class="text-sm text-gray-500">Top Experience</p>
          <h4 class="font-semibold text-gray-900">Karnak Temple</h4>
        </div>
      </div>

      <!-- Activities -->
      <div class="grid sm:grid-cols-2 gap-8">
        <div
          class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden"
        >
          <div
            class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"
          >
          </div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">
            Karnak Temple
          </h3>
          <p class="text-gray-600 text-sm">
            Explore one of the largest temple complexes in the world, filled
            with towering columns and ancient hieroglyphs.
          </p>
        </div>

        <div
          class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden"
        >
          <div
            class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"
          >
          </div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">
            Valley of the Kings
          </h3>
          <p class="text-gray-600 text-sm">
            Discover the royal tombs of ancient pharaohs, including the famous
            tomb of Tutankhamun.
          </p>
        </div>

        <div
          class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden"
