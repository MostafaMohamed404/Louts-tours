<section class="py-24 bg-[#f8f8f8]">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">

    <!-- Title -->
    <div class="text-center mb-20">
      <span class="text-sm tracking-[4px] text-[#C9A24D] font-semibold uppercase">
        Suggested Itinerary
      </span>

      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-3">
        Perfect Day in Luxor
      </h2>

      <p class="text-gray-500 mt-4 max-w-2xl mx-auto">
        Step back in time and explore the wonders of ancient Egypt in one unforgettable day,
        from majestic temples to royal tombs and breathtaking views over the Nile.
      </p>
    </div>

    <!-- Timeline -->
    <div class="relative">

      <!-- center line -->
      <div class="hidden lg:block absolute left-1/2 top-0 h-full w-[2px] bg-[#C9A24D]/30"></div>

      <div class="space-y-16">

        <!-- Item 1 -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">

          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img src="/images/luxor-balloon.webp"
              alt="Hot Air Balloon"
              loading="lazy"
              class="w-full h-full object-cover">
          </div>

          <div class="bg-white p-8 rounded-2xl shadow-md">
            <span class="text-[#C9A24D] font-semibold text-sm">1 Hour</span>
            <h3 class="text-2xl font-bold mt-2 mb-3">Hot Air Balloon Ride</h3>
            <p class="text-gray-600">
              Start your day with a magical sunrise hot air balloon ride over Luxor,
              offering panoramic views of temples, the Nile, and the desert.
            </p>
          </div>

        </div>

        <!-- Item 2 -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">

          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <span class="text-[#C9A24D] font-semibold text-sm">2 Hours</span>
            <h3 class="text-2xl font-bold mt-2 mb-3">Valley of the Kings</h3>
            <p class="text-gray-600">
              Explore the ancient royal tombs carved into the mountains, including
              the famous tomb of Tutankhamun.
            </p>
          </div>

          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img src="/images/valley-of-kings.webp"
              alt="Valley of the Kings"
              loading="lazy"
              class="w-full h-full object-cover">
          </div>

        </div>

        <!-- Item 3 -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">

          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img src="/images/hatshepsut-temple.webp"
              alt="Hatshepsut Temple"
              loading="lazy"
              class="w-full h-full object-cover">
          </div>

          <div class="bg-white p-8 rounded-2xl shadow-md">
            <span class="text-[#C9A24D] font-semibold text-sm">1.5 Hours</span>
            <h3 class="text-2xl font-bold mt-2 mb-3">Hatshepsut Temple</h3>
            <p class="text-gray-600">
              Visit the stunning temple of Queen Hatshepsut, uniquely built into
              the cliffs of Deir el-Bahari.
            </p>
          </div>

        </div>

        <!-- Item 4 -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">

          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <span class="text-[#C9A24D] font-semibold text-sm">1 Hour</span>
            <h3 class="text-2xl font-bold mt-2 mb-3">Colossi of Memnon</h3>
            <p class="text-gray-600">
              Stop by the massive twin statues that have stood for thousands of years
              guarding the ancient Theban necropolis.
            </p>
          </div>

          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img src="/images/memnon-statues.webp"
              alt="Colossi of Memnon"
              loading="lazy"
              class="w-full h-full object-cover">
          </div>

        </div>

        <!-- Item 5 -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">

          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img src="/images/karnak-temple.webp"
              alt="Karnak Temple"
              loading="lazy"
              class="w-full h-full object-cover">
          </div>

          <div class="bg-white p-8 rounded-2xl shadow-md">
            <span class="text-[#C9A24D] font-semibold text-sm">2 Hours</span>
            <h3 class="text-2xl font-bold mt-2 mb-3">Karnak Temple</h3>
            <p class="text-gray-600">
              Explore the vast Karnak Temple complex, filled with towering columns
              and incredible ancient carvings.
            </p>
          </div>

        </div>

        <!-- Item 6 -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">

          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <span class="text-[#C9A24D] font-semibold text-sm">1.5 Hours</span>
            <h3 class="text-2xl font-bold mt-2 mb-3">Luxor Temple</h3>
            <p class="text-gray-600">
              End your day at Luxor Temple, beautifully illuminated at night,
              offering a magical and unforgettable atmosphere.
            </p>
          </div>

          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img src="/images/luxor-temple.webp"
              alt="Luxor Temple"
              loading="lazy"
              class="w-full h-full object-cover">
          </div>

        </div>

      </div>

    </div>

  </div>
</section>