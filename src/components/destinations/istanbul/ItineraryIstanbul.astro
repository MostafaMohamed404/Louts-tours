<!-- Itinerary Istanbul -->
<section class="py-24 bg-[#f8f8f8]">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <div class="text-center mb-20">
      <span class="text-sm tracking-[4px] text-[#C9A24D] font-semibold uppercase">Suggested Itinerary</span>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-3">Discover the Best of Istanbul</h2>
      <p class="text-gray-500 mt-4 max-w-2xl mx-auto leading-relaxed">A perfectly planned journey through Istanbul's most iconic landmarks and unforgettable experiences.</p>
    </div>
    <div class="relative">
      <div class="hidden lg:block absolute left-1/2 top-0 h-full w-[2px] bg-[#C9A24D]/30 -translate-x-1/2"></div>
      <div class="space-y-16">
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img src="/images/hagia-sophia.webp" alt="Hagia Sophia" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">1</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Morning</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Hagia Sophia</h3>
            <p class="text-gray-600 leading-relaxed">Begin with the awe-inspiring Hagia Sophia — one of the greatest architectural achievements in human history.</p>
          </div>
        </div>
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">2</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Mid-Morning</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Blue Mosque</h3>
            <p class="text-gray-600 leading-relaxed">Walk across to the iconic Blue Mosque and admire its stunning six minarets and beautiful tile interior.</p>
          </div>
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img src="/images/blue-mosque.webp" alt="Blue Mosque" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
        </div>
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img src="/images/grand-bazaar.webp" alt="Grand Bazaar" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">3</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Afternoon</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Grand Bazaar</h3>
            <p class="text-gray-600 leading-relaxed">Lose yourself in one of the world's oldest covered markets, filled with thousands of shops and vibrant colors.</p>
          </div>
        </div>
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">4</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Late Afternoon</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Topkapi Palace</h3>
            <p class="text-gray-600 leading-relaxed">Explore the opulent palace of the Ottoman sultans and its treasury of priceless historical artifacts.</p>
          </div>
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img src="/images/topkapi-palace.webp" alt="Topkapi Palace" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
        </div>
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img src="/images/bosphorus.webp" alt="Bosphorus Cruise" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition duration-500"/>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">5</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Evening</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Bosphorus Cruise</h3>
            <p class="text-gray-600 leading-relaxed">End your day with a magical sunset cruise along the Bosphorus strait between Europe and Asia.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
