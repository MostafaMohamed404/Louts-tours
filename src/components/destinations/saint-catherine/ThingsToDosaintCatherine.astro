<!-- Things To Do Saint Catherine -->
<section class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6 lg:px-16">

    <!-- Title -->
    <div class="max-w-2xl mb-16">
      <span class="text-[#C9A24D] uppercase tracking-[4px] text-sm font-semibold">
        Experiences
      </span>
      <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mt-4">
        Things To Do in Saint Catherine
      </h2>
      <p class="text-gray-600 mt-6 leading-relaxed">
        From summiting a biblical mountain at sunrise to exploring one of the world's
        oldest monasteries — Saint Catherine offers spiritual, historical, and natural
        experiences that leave a lasting impression.
      </p>
    </div>

    <!-- Layout -->
    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <!-- Image -->
      <div class="relative">
        <img
          src="/images/mount-sinai.webp"
          alt="Mount Sinai top experience"
          class="rounded-3xl object-cover w-full h-[520px]"
          loading="lazy"
        />
        <div class="absolute bottom-6 left-6 bg-white/90 backdrop-blur rounded-xl px-6 py-4 shadow-lg">
          <p class="text-sm text-gray-500">Top Experience</p>
          <h4 class="font-semibold text-gray-900">Sunrise at Mount Sinai</h4>
        </div>
      </div>

      <!-- Activities Grid -->
      <div class="grid sm:grid-cols-2 gap-6">

        <div class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"></div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">Mount Sinai Trek</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Hike the biblical mountain by night and reach the summit just in time for the sunrise.
          </p>
        </div>

        <div class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"></div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">Monastery Visit</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Explore one of the world's oldest Christian monasteries, founded in the 6th century.
          </p>
        </div>

        <div class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"></div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">Burning Bush</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Visit the sacred bush inside the monastery grounds — a deeply meaningful biblical site.
          </p>
        </div>

        <div class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"></div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">Stargazing</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            The high altitude and dark skies make Saint Catherine a premier stargazing destination.
          </p>
        </div>

        <div class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"></div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">Mountain Hiking</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Explore the dramatic red granite mountains surrounding the monastery on guided hikes.
          </p>
        </div>

        <div class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"></div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">Bedouin Culture</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Meet the local Bedouin people, enjoy traditional tea, and learn about their unique desert heritage.
          </p>
        </div>

      </div>
    </div>
  </div>
</section>
