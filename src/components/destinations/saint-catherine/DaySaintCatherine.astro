<!-- Day Saint Catherine - Suggested Itinerary -->
<section class="py-24 bg-[#f8f8f8]">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">

    <!-- Title -->
    <div class="text-center mb-20">
      <span class="text-sm tracking-[4px] text-[#C9A24D] font-semibold uppercase">
        Suggested Itinerary
      </span>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-3">
        A Day in Saint Catherine
      </h2>
      <p class="text-gray-500 mt-4 max-w-2xl mx-auto leading-relaxed">
        Begin your night trek up Mount Sinai, witness the most spectacular sunrise in Egypt,
        then explore the ancient monastery below.
      </p>
    </div>

    <!-- Timeline -->
    <div class="relative">

      <!-- Center Line -->
      <div class="hidden lg:block absolute left-1/2 top-0 h-full w-[2px] bg-[#C9A24D]/30 -translate-x-1/2"></div>

      <div class="space-y-16">

        <!-- Stop 1: Night Trek -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img
              src="/images/mount-sinai.webp"
              alt="Mount Sinai night trek"
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">1</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Midnight — 2:00 AM</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Night Trek up Mount Sinai</h3>
            <p class="text-gray-600 leading-relaxed">
              Begin the 3–4 hour ascent by moonlight. The trail is well-marked and guided.
              Choose between the main Camel Path or the challenging Stairs of Repentance.
            </p>
          </div>
        </div>

        <!-- Stop 2: Sunrise -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">2</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Sunrise — ~5:30 AM</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Sunrise at the Summit</h3>
            <p class="text-gray-600 leading-relaxed">
              Arrive at the 2,285m summit just before dawn. Watch the sun rise over
              the Sinai mountains — a spiritual and breathtaking moment that stays with you forever.
            </p>
          </div>
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img
              src="/images/sinai-mountains.webp"
              alt="Sunrise Mount Sinai summit"
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
        </div>

        <!-- Stop 3: Monastery -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img
              src="/images/saint-catherine-monastery.webp"
              alt="Saint Catherine Monastery visit"
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">3</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Morning — 9:00 AM</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Saint Catherine's Monastery</h3>
            <p class="text-gray-600 leading-relaxed">
              Descend and visit the ancient monastery, built in 548 AD. Explore the
              Chapel of the Burning Bush, the ancient icon collection, and the historic library.
            </p>
          </div>
        </div>

        <!-- Stop 4: Garden & Return -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">4</span>
              <span class="text-[#C9A24D] font-semibold text-sm">Late Morning & Return</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">The Monastery Garden & Departure</h3>
            <p class="text-gray-600 leading-relaxed">
              Visit the monks' garden and Moses' Well before enjoying a light lunch
              in the village. Then depart back to Cairo or Sharm El Sheikh refreshed
              and full of extraordinary memories.
            </p>
          </div>
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img
              src="/images/burning-bush.webp"
              alt="Burning Bush monastery garden"
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
