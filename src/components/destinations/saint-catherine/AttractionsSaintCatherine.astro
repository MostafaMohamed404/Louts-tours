<!-- Attractions Saint Catherine -->
<section class="py-24 bg-[#f8f8f8]">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">

    <!-- Heading -->
    <div class="text-center mb-16">
      <span class="text-sm tracking-[4px] text-[#C9A24D] font-semibold uppercase">
        Top Attractions
      </span>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-3">
        Places to Visit in Saint Catherine
      </h2>
      <p class="text-gray-600 mt-4 max-w-2xl mx-auto">
        Ancient monasteries, biblical mountains, and dramatic granite landscapes —
        Saint Catherine offers a journey through history, faith, and nature.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">

      <!-- Mount Sinai -->
      <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300">
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/mount-sinai.webp"
            alt="Mount Sinai sunrise trek Egypt"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Mount Sinai (Jebel Musa)</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            The biblical mountain where Moses received the Ten Commandments.
            Trek by night to reach the 2,285m summit for an unforgettable sunrise.
          </p>
        </div>
      </div>

      <!-- Saint Catherine Monastery -->
      <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300">
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/saint-catherine-monastery.webp"
            alt="Saint Catherine Monastery Sinai"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Saint Catherine's Monastery</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            One of the world's oldest Christian monasteries, built in the 6th century
            and home to a priceless collection of ancient icons and manuscripts.
          </p>
        </div>
      </div>

      <!-- Burning Bush -->
      <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300">
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/burning-bush.webp"
            alt="Burning Bush Saint Catherine Monastery"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">The Burning Bush</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            The legendary bush where God is said to have spoken to Moses,
            still growing inside the monastery grounds today.
          </p>
        </div>
      </div>

      <!-- Sinai Granite Mountains -->
      <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300">
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/sinai-mountains.webp"
            alt="Sinai granite mountains landscape"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Sinai Granite Mountains</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            Dramatic red and orange granite mountains surround the area,
            offering spectacular scenery and hiking trails.
          </p>
        </div>
      </div>

      <!-- Moses' Well -->
      <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300">
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/moses-well.webp"
            alt="Moses Well Saint Catherine Sinai"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Moses' Well</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            The historic well near the monastery where Moses is said to have
            met the daughters of Jethro — a significant biblical landmark.
          </p>
        </div>
      </div>

      <!-- Sinai Stargazing -->
      <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300">
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/sinai-stars.webp"
            alt="Stargazing Sinai desert Egypt"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Sinai Night Sky</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            The high altitude and clear desert air make Saint Catherine one of the
            best stargazing spots in the Middle East.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
