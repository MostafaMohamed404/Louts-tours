<!-- Activity Alexandria -->
<section class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6 lg:px-16">

    <!-- Title -->
    <div class="max-w-2xl mb-16">
      <span class="text-[#C9A24D] uppercase tracking-[4px] text-sm font-semibold">
        Experiences
      </span>
      <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mt-4">
        Things To Do in Alexandria
      </h2>
      <p class="text-gray-600 mt-6 leading-relaxed">
        From ancient landmarks and cultural treasures to Mediterranean
        promenades and royal gardens, Alexandria offers a perfect mix
        of history, culture, and coastal beauty.
      </p>
    </div>

    <!-- Layout -->
    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <!-- Image -->
      <div class="relative">
        <img
          src="/images/qaitbay.webp"
          alt="Citadel of Qaitbay Alexandria top experience"
          class="rounded-3xl object-cover w-full h-[520px]"
          loading="lazy"
        />
        <div class="absolute bottom-6 left-6 bg-white/90 backdrop-blur rounded-xl px-6 py-4 shadow-lg">
          <p class="text-sm text-gray-500">Top Experience</p>
          <h4 class="font-semibold text-gray-900">Citadel of Qaitbay</h4>
        </div>
      </div>

      <!-- Activities Grid -->
      <div class="grid sm:grid-cols-2 gap-6">

        <div class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"></div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">Visit Bibliotheca Alexandrina</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Discover the modern revival of the legendary Library of Alexandria.
          </p>
        </div>

        <div class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"></div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">Explore Pompey's Pillar</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            See one of the most impressive Roman monuments in Egypt.
          </p>
        </div>

        <div class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"></div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">Walk the Corniche</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Enjoy scenic Mediterranean views along Alexandria's famous waterfront.
          </p>
        </div>

        <div class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"></div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">Discover Qaitbay Citadel</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Explore the historic fortress built on the ancient lighthouse site.
          </p>
        </div>

        <div class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"></div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">Montaza Palace Gardens</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Relax in beautiful royal gardens overlooking the Mediterranean.
          </p>
        </div>

        <div class="group p-6 border border-[#C9A24D]/20 rounded-2xl hover:border-[#C9A24D] hover:shadow-lg transition relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-[3px] bg-[#C9A24D] opacity-0 group-hover:opacity-100 transition"></div>
          <h3 class="font-semibold text-lg mb-2 text-gray-900">Seafood Dining</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Taste fresh Mediterranean seafood in Alexandria's famous restaurants.
          </p>
        </div>

      </div>
    </div>
  </div>
</section>