<!-- Attractions Alexandria -->
<section class="py-24 bg-[#f8f8f8]">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">
    <!-- Heading -->
    <div class="text-center mb-16">
      <span
        class="text-sm tracking-[4px] text-[#C9A24D] font-semibold uppercase"
      >
        Top Attractions
      </span>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-3">
        Best Places to Visit in Alexandria
      </h2>
      <p class="text-gray-600 mt-4 max-w-2xl mx-auto">
        Alexandria is one of Egypt's most historic Mediterranean cities, famous
        for its ancient landmarks, cultural attractions, and scenic coastal
        views.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Qaitbay Citadel -->
      <div
        class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300"
      >
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/qaitbay.webp"
            alt="Citadel of Qaitbay Alexandria fortress on Mediterranean Sea"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">
            Citadel of Qaitbay
          </h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            A historic 15th-century fortress overlooking the Mediterranean Sea,
            built on the site of the ancient Lighthouse of Alexandria.
          </p>
        </div>
      </div>

      <!-- Bibliotheca Alexandrina -->
      <div
        class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300"
      >
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/library.webp"
            alt="Bibliotheca Alexandrina modern library cultural center Alexandria Egypt"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">
            Bibliotheca Alexandrina
          </h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            A modern cultural landmark inspired by the ancient Library of
            Alexandria, hosting museums, exhibitions, and international cultural
            events.
          </p>
        </div>
      </div>

      <!-- Montaza Palace -->
      <div
        class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300"
      >
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/montaza.webp"
            alt="Montaza Palace gardens overlooking Mediterranean Sea Alexandria Egypt"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Montaza Palace</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            Beautiful royal gardens and historic buildings overlooking the
            Mediterranean, offering scenic landscapes and peaceful coastal
            views.
          </p>
        </div>
      </div>

      <!-- Pompey's Pillar -->
      <div
        class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300"
      >
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/pompey.webp"
            alt="Pompeys Pillar Roman monument Alexandria Egypt"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Pompey's Pillar</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            A massive Roman granite column and one of the largest ancient
            monuments in Alexandria, reflecting the city's importance during the
            Roman era.
          </p>
        </div>
      </div>

      <!-- Lighthouse Site -->
      <div
        class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300"
      >
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/lighthouse-site.webp"
            alt="Ancient Lighthouse of Alexandria site Pharos island Mediterranean coast"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">Lighthouse Site</h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            The historic location of the ancient Pharos Lighthouse, one of the
            Seven Wonders of the Ancient World.
          </p>
        </div>
      </div>

      <!-- Alexandria Corniche -->
      <div
        class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300"
      >
        <div class="overflow-hidden h-[220px]">
          <img
            src="/images/corniche.webp"
            alt="Alexandria Corniche Mediterranean seaside promenade Egypt"
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900">
            Alexandria Corniche
          </h3>
          <p class="text-gray-600 mt-2 text-sm leading-relaxed">
            A scenic seaside promenade stretching along the Mediterranean coast,
            famous for its sea views, sunsets, and vibrant atmosphere.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
