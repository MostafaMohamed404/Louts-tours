<!-- Day Alexandria - Suggested Itinerary -->
<section class="py-24 bg-[#f8f8f8]">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">

    <!-- Title -->
    <div class="text-center mb-20">
      <span class="text-sm tracking-[4px] text-[#C9A24D] font-semibold uppercase">
        Suggested Itinerary
      </span>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-3">
        Perfect Day in Alexandria
      </h2>
      <p class="text-gray-500 mt-4 max-w-2xl mx-auto leading-relaxed">
        Discover the most iconic landmarks of Alexandria in one perfectly planned day
        combining history, culture, and stunning Mediterranean views.
      </p>
    </div>

    <!-- Timeline -->
    <div class="relative">

      <!-- Center Line (desktop only) -->
      <div class="hidden lg:block absolute left-1/2 top-0 h-full w-[2px] bg-[#C9A24D]/30 -translate-x-1/2"></div>

      <div class="space-y-16">

        <!-- Stop 1: Pompey's Pillar -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img
              src="/images/pompey.webp"
              alt="Pompeys Pillar Alexandria"
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">1</span>
              <span class="text-[#C9A24D] font-semibold text-sm">~45 Minutes</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Pompey's Pillar</h3>
            <p class="text-gray-600 leading-relaxed">
              Start your day exploring the famous Roman column — one of the most
              impressive ancient monuments in Alexandria with surrounding catacombs.
            </p>
          </div>
        </div>

        <!-- Stop 2: Qaitbay Citadel -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">2</span>
              <span class="text-[#C9A24D] font-semibold text-sm">~1 Hour</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Citadel of Qaitbay</h3>
            <p class="text-gray-600 leading-relaxed">
              Head to the historic fortress built on the exact site of the ancient
              Pharos Lighthouse, overlooking the beautiful Mediterranean Sea.
            </p>
          </div>
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img
              src="/images/qaitbay.webp"
              alt="Citadel of Qaitbay Alexandria"
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
        </div>

        <!-- Stop 3: Lighthouse Site -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img
              src="/images/lighthouse-site.webp"
              alt="Lighthouse Site Alexandria Pharos"
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">3</span>
              <span class="text-[#C9A24D] font-semibold text-sm">~30 Minutes</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Lighthouse Site</h3>
            <p class="text-gray-600 leading-relaxed">
              Stop at the historic location of the legendary Pharos Lighthouse,
              one of the Seven Wonders of the Ancient World, and enjoy coastal views.
            </p>
          </div>
        </div>

        <!-- Stop 4: Bibliotheca Alexandrina -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="bg-white p-8 rounded-2xl shadow-md order-2 lg:order-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">4</span>
              <span class="text-[#C9A24D] font-semibold text-sm">~1 Hour</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Bibliotheca Alexandrina</h3>
            <p class="text-gray-600 leading-relaxed">
              Visit the modern architectural masterpiece that revives the legendary
              ancient Library of Alexandria, with museums and cultural exhibitions inside.
            </p>
          </div>
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg order-1 lg:order-2">
            <img
              src="/images/library.webp"
              alt="Bibliotheca Alexandrina library Egypt"
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
        </div>

        <!-- Stop 5: Montaza Palace -->
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div class="h-[320px] overflow-hidden rounded-2xl shadow-lg">
            <img
              src="/images/montaza.webp"
              alt="Montaza Palace Gardens Alexandria"
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-[#C9A24D] text-white text-sm font-bold flex items-center justify-center">5</span>
              <span class="text-[#C9A24D] font-semibold text-sm">~1.5 Hours</span>
            </div>
            <h3 class="text-2xl font-bold mb-3">Montaza Palace Gardens</h3>
            <p class="text-gray-600 leading-relaxed">
              End your day relaxing in the beautiful royal gardens surrounded by
              palm trees and breathtaking Mediterranean sea views.
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>