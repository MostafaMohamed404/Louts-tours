<!-- Attractions Saudi Arabia -->
<section class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6 lg:px-20">

    <div class="text-center mb-16">
      <span class="text-sm tracking-[4px] text-[#C9A24D] font-semibold uppercase">Top Attractions</span>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-3">Best Places to Visit in Saudi Arabia</h2>
      <p class="text-gray-600 mt-4 max-w-2xl mx-auto">Iconic landmarks, spiritual destinations, and breathtaking natural wonders — all waiting for you in the Kingdom.</p>
    </div>

    <!-- First row: large featured card + two smaller cards -->
    <div class="grid lg:grid-cols-3 gap-6 mb-6">

      <!-- Featured large card -->
      <div class="lg:col-span-2 relative overflow-hidden rounded-3xl h-[380px] group shadow-lg">
        <img src="/images/masjid-haram.webp" alt="Masjid Al-Haram Makkah" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" loading="lazy"/>
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
        <div class="absolute bottom-0 left-0 p-8 text-white">
          <span class="text-xs uppercase tracking-widest text-[#C9A24D] font-semibold mb-2 block">Holy Site</span>
          <h3 class="text-2xl font-bold">Masjid Al-Haram</h3>
          <p class="text-white/80 mt-2 text-sm max-w-md leading-relaxed">The holiest mosque in Islam and the largest in the world, surrounding the sacred Kaaba in the heart of Makkah.</p>
        </div>
      </div>

      <!-- Side stack -->
      <div class="flex flex-col gap-6">
        <div class="relative overflow-hidden rounded-3xl h-[177px] group shadow-lg">
          <img src="/images/madinah.webp" alt="Madinah Saudi Arabia" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" loading="lazy"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/65 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-5 text-white">
            <h3 class="text-lg font-bold">Al-Madinah Al-Munawwarah</h3>
            <p class="text-white/80 text-xs mt-1">City of the Prophet ﷺ</p>
          </div>
        </div>
        <div class="relative overflow-hidden rounded-3xl h-[177px] group shadow-lg">
          <img src="/images/diriyah.webp" alt="Diriyah Saudi Arabia" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" loading="lazy"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/65 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-5 text-white">
            <h3 class="text-lg font-bold">Diriyah</h3>
            <p class="text-white/80 text-xs mt-1">Birthplace of the Kingdom</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Second row: three equal cards -->
    <div class="grid md:grid-cols-3 gap-6">
      <div class="relative overflow-hidden rounded-3xl h-[240px] group shadow-lg">
        <img src="/images/al-ula.webp" alt="Al-Ula Saudi Arabia" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" loading="lazy"/>
        <div class="absolute inset-0 bg-gradient-to-t from-black/65 to-transparent"></div>
        <div class="absolute bottom-0 left-0 p-5 text-white">
          <h3 class="text-lg font-bold">Al-Ula</h3>
          <p class="text-white/80 text-xs mt-1">Ancient wonders & Nabataean ruins</p>
        </div>
      </div>
      <div class="relative overflow-hidden rounded-3xl h-[240px] group shadow-lg">
        <img src="/images/riyadh-skyline.webp" alt="Riyadh Saudi Arabia" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" loading="lazy"/>
        <div class="absolute inset-0 bg-gradient-to-t from-black/65 to-transparent"></div>
        <div class="absolute bottom-0 left-0 p-5 text-white">
          <h3 class="text-lg font-bold">Riyadh</h3>
          <p class="text-white/80 text-xs mt-1">The modern capital of the Kingdom</p>
        </div>
      </div>
      <div class="relative overflow-hidden rounded-3xl h-[240px] group shadow-lg">
        <img src="/images/red-sea.webp" alt="Red Sea Saudi Arabia" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" loading="lazy"/>
        <div class="absolute inset-0 bg-gradient-to-t from-black/65 to-transparent"></div>
        <div class="absolute bottom-0 left-0 p-5 text-white">
          <h3 class="text-lg font-bold">Red Sea Coast</h3>
          <p class="text-white/80 text-xs mt-1">World-class diving & beaches</p>
        </div>
      </div>
    </div>

  </div>
</section>
