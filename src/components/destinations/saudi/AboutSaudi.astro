<!-- About Saudi Arabia -->
<section class="relative py-24 bg-[#f8f5ef] overflow-hidden">

  <!-- Decorative background shape -->
  <div class="absolute right-0 top-0 w-1/3 h-full bg-[#C9A24D]/5 rounded-l-[80px] hidden lg:block"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-20 relative z-10">

    <!-- Top label -->
    <div class="text-center mb-16">
      <span class="text-sm tracking-[4px] text-[#C9A24D] font-semibold uppercase">Saudi Arabia Destination</span>
      <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mt-4 leading-tight">
        The Kingdom That Has <span class="text-[#C9A24D]">Everything</span>
      </h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <!-- Image with floating stat card -->
      <div class="relative">
        <img
          src="/images/about-saudi.webp"
          alt="Saudi Arabia Travel Destination"
          loading="lazy"
          class="w-full h-[480px] object-cover rounded-[30px] shadow-2xl"
        />
        <!-- Floating card -->
        <div class="absolute -bottom-6 -right-6 bg-white rounded-2xl shadow-xl px-6 py-4 text-center hidden md:block">
          <p class="text-3xl font-bold text-[#C9A24D]">2030</p>
          <p class="text-sm text-gray-500 mt-1">Vision Era</p>
        </div>
      </div>

      <!-- Text content -->
      <div>
        <p class="text-gray-600 leading-relaxed text-lg">
          Saudi Arabia is a land of extraordinary contrasts — ancient history meets bold modernity. From the holy cities of Makkah and Madinah to the UNESCO-listed ruins of Al-Ula and Hegra, the Kingdom is one of the most captivating destinations in the world.
        </p>
        <p class="text-gray-600 mt-4 leading-relaxed text-lg">
          With Lotus Tours, your Saudi journey is expertly crafted — from hotel reservations and religious packages to adventure tours, with dedicated guides accompanying you every step of the way.
        </p>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-6 mt-10 pt-10 border-t border-gray-200">
          <div>
            <p class="text-3xl font-bold text-[#C9A24D]">Oct–Mar</p>
            <p class="text-sm text-gray-500 mt-1">Best to Visit</p>
          </div>
          <div>
            <p class="text-3xl font-bold text-[#C9A24D]">SAR</p>
            <p class="text-sm text-gray-500 mt-1">Currency</p>
          </div>
          <div>
            <p class="text-3xl font-bold text-[#C9A24D]">Arabic</p>
            <p class="text-sm text-gray-500 mt-1">Language</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
