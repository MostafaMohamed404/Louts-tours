---
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">

  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/Domestic-Tourism.webp"
      alt="Egypt Travel"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-6 max-w-5xl mx-auto">

    <!-- Badge -->
    <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 text-white text-sm font-medium px-5 py-2 rounded-full mb-8">
      <i class="fa-solid fa-star text-[#C6A75E]"></i>
      Trusted by 10,000+ Happy Travelers
    </div>

    <!-- Heading -->
    <h1 class="text-5xl md:text-7xl font-bold text-white leading-tight mb-6">
      Discover Egypt &
      <span class="text-[#C6A75E]"> Beyond</span>
    </h1>

    <!-- Subheading -->
    <p class="text-lg md:text-xl text-white/80 leading-relaxed max-w-2xl mx-auto mb-12">
      From the Nile to the world — we craft unforgettable journeys tailored just for you.
      Domestic trips, international tours, Hajj & Umrah, and more.
    </p>

    <!-- Buttons -->
    <div class="flex flex-col sm:flex-row gap-5 justify-center">
      <a
        href="/booking"
        class="inline-flex items-center justify-center gap-3 bg-[#C8A976] text-white font-semibold px-10 py-4 rounded-2xl hover:bg-[#b2965c] hover:scale-105 transition transform duration-300 shadow-lg"
      >
        <i class="fa-solid fa-calendar-check"></i>
        Book Your Trip
      </a>
      <a
        href="/tours/domestic"
        class="inline-flex items-center justify-center gap-3 bg-white/10 backdrop-blur-sm border border-white/30 text-white font-semibold px-10 py-4 rounded-2xl hover:bg-white/20 hover:scale-105 transition transform duration-300"
      >
        <i class="fa-solid fa-map-location-dot"></i>
        Explore Tours
      </a>
    </div>

  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-10 animate-bounce">
    <i class="fa-solid fa-chevron-down text-white/60 text-2xl"></i>
  </div>

</section>