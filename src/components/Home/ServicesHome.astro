---
---

<section class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6">

    <!-- Header -->
    <div class="text-center mb-16">
      <span class="text-sm uppercase tracking-widest text-[#C6A75E] font-semibold">
        What We Offer
      </span>
      <h2 class="text-4xl md:text-5xl font-bold text-[#3E2F1C] mt-4">
        Our Services
      </h2>
      <p class="text-gray-500 mt-4 max-w-xl mx-auto text-lg">
        Everything you need for a perfect trip — all in one place.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

      <!-- Domestic -->
      <a href="/tourism/domestic" class="group bg-[#FFF] rounded-3xl p-8 hover:shadow-xl transition duration-300 hover:-translate-y-1">
        <div class="w-14 h-14 bg-white rounded-2xl shadow flex items-center justify-center mb-6">
          <i class="fa-solid fa-map-location-dot text-[#ddef81] text-2xl"></i>
        </div>
        <h3 class="text-xl font-bold text-[#3E2F1C] mb-3">Domestic Tourism</h3>
        <p class="text-gray-500 text-sm leading-relaxed">
          Explore Egypt's finest destinations — Hurghada, Sharm, Luxor, Aswan, Siwa and more.
        </p>
        <div class="mt-6 flex items-center gap-2 text-[#C8A976] font-semibold text-sm group-hover:gap-3 transition-all">
          Explore <i class="fa-solid fa-arrow-right"></i>
        </div>
      </a>

      <!-- International -->
      <a href="/tourism/international" class="group bg-[#FFF] rounded-3xl p-8 hover:shadow-xl transition duration-300 hover:-translate-y-1">
        <div class="w-14 h-14 bg-white rounded-2xl shadow flex items-center justify-center mb-6">
          <i class="fa-solid fa-globe text-[#ddef81] text-2xl"></i>
        </div>
        <h3 class="text-xl font-bold text-[#3E2F1C] mb-3">International Tourism</h3>
        <p class="text-gray-500 text-sm leading-relaxed">
          Travel to Dubai, Turkey, Europe, and more with our fully managed international packages.
        </p>
        <div class="mt-6 flex items-center gap-2 text-[#C8A976] font-semibold text-sm group-hover:gap-3 transition-all">
          Explore <i class="fa-solid fa-arrow-right"></i>
        </div>
      </a>

      <!-- Religious -->
      <a href="/tourism/religious" class="group bg-[#fff] rounded-3xl p-8 hover:shadow-xl transition duration-300 hover:-translate-y-1">
        <div class="w-14 h-14 bg-white rounded-2xl shadow flex items-center justify-center mb-6">
          <i class="fa-solid fa-kaaba text-[#ddef81] text-2xl"></i>
        </div>
        <h3 class="text-xl font-bold text-[#3E2F1C] mb-3">Religious Tourism</h3>
        <p class="text-gray-500 text-sm leading-relaxed">
          Hajj & Umrah packages with full supervision, accommodation near Haram, and guided tours.
        </p>
        <div class="mt-6 flex items-center gap-2 text-[#C8A976] font-semibold text-sm group-hover:gap-3 transition-all">
          Explore <i class="fa-solid fa-arrow-right"></i>
        </div>
      </a>

      <!-- Nile Cruise -->
      <a href="/services/nile-cruise" class="group bg-[#FFF] rounded-3xl p-8 hover:shadow-xl transition duration-300 hover:-translate-y-1">
        <div class="w-14 h-14 bg-white rounded-2xl shadow flex items-center justify-center mb-6">
          <i class="fa-solid fa-ship text-[#ddef81] text-2xl"></i>
        </div>
        <h3 class="text-xl font-bold text-[#3E2F1C] mb-3">Nile Cruises</h3>
        <p class="text-gray-500 text-sm leading-relaxed">
          Sail the Nile between Luxor and Aswan. Luxury cabins, ancient temples, unforgettable views.
        </p>
        <div class="mt-6 flex items-center gap-2 text-[#C8A976] font-semibold text-sm group-hover:gap-3 transition-all">
          Explore <i class="fa-solid fa-arrow-right"></i>
        </div>
      </a>

      <!-- Visas -->
      <a href="/services/visas" class="group bg-[#FFF] rounded-3xl p-8 hover:shadow-xl transition duration-300 hover:-translate-y-1">
        <div class="w-14 h-14 bg-white rounded-2xl shadow flex items-center justify-center mb-6">
          <i class="fa-solid fa-passport text-[#ddef81] text-2xl"></i>
        </div>
        <h3 class="text-xl font-bold text-[#3E2F1C] mb-3">Visa Services</h3>
        <p class="text-gray-500 text-sm leading-relaxed">
          Fast and reliable visa assistance for Greece, Turkey, UAE, Saudi Arabia, and more.
        </p>
        <div class="mt-6 flex items-center gap-2 text-[#C8A976] font-semibold text-sm group-hover:gap-3 transition-all">
          Explore <i class="fa-solid fa-arrow-right"></i>
        </div>
      </a>

      <!-- Flights -->
      <a href="/services/flights" class="group bg-[#fff] rounded-3xl p-8 hover:shadow-xl transition duration-300 hover:-translate-y-1">
        <div class="w-14 h-14 bg-white rounded-2xl shadow flex items-center justify-center mb-6">
          <i class="fa-solid fa-plane-departure text-[#ddef81] text-2xl"></i>
        </div>
        <h3 class="text-xl font-bold text-[#3E2F1C] mb-3">Flight Booking</h3>
        <p class="text-gray-500 text-sm leading-relaxed">
          Book international and domestic flights at the best prices with 24/7 expert support.
        </p>
        <div class="mt-6 flex items-center gap-2 text-[#C8A976] font-semibold text-sm group-hover:gap-3 transition-all">
          Explore <i class="fa-solid fa-arrow-right"></i>
        </div>
      </a>

    </div>
  </div>
</section>