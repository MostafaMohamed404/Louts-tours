            <div class="absolute bottom-6 left-6 text-white">
              <h3 class="text-2xl font-bold">Sharm El Sheikh</h3>
              <p class="text-white/80 text-sm mt-1 flex items-center gap-2">
                <i class="fa-solid fa-location-dot text-[#C6A75E]"></i> South Sinai,
                Egypt
              </p>
            </div>
          </a>
        </div>

        <!-- Luxor -->
        <div class="swiper-slide">
          <a
            href="/destinations/luxor"
            class="group block relative rounded-3xl overflow-hidden shadow-lg"
          >
            <img
              src="/images/luxor.webp"
              alt="Luxor"
              loading="lazy"
