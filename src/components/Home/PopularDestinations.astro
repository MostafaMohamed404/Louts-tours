---

---

<section class="py-24 bg-[#FFF]">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Header -->
    <div
      class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6"
    >
      <div>
        <span
          class="text-sm uppercase tracking-widest text-[#C6A75E] font-semibold"
        >
          Top Picks
        </span>
        <h2 class="text-4xl md:text-5xl font-bold text-[#3E2F1C] mt-4">
          Popular Destinations
        </h2>
      </div>
      <a
        href="/tourism/domestic"
        class="inline-flex items-center gap-2 text-[#C8A976] font-semibold hover:gap-4 transition-all"
      >
        View All <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>

    <!-- Swiper -->
    <div class="swiper popularSwiper">
      <div class="swiper-wrapper pb-10">
        <!-- Hurghada -->
        <div class="swiper-slide">
          <a
            href="/destinations/hurghada"
            class="group block relative rounded-3xl overflow-hidden shadow-lg"
          >
            <img
              src="/images/hurghada.webp"
              alt="Hurghada"
              loading="lazy"
              width="640"
              height="320"
              class="w-full h-80 object-cover group-hover:scale-105 transition duration-500"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"
            >
            </div>
            <div class="absolute bottom-6 left-6 text-white">
              <h3 class="text-2xl font-bold">Hurghada</h3>
              <p class="text-white/80 text-sm mt-1 flex items-center gap-2">
                <i class="fa-solid fa-location-dot text-[#C6A75E]"></i> Red Sea, Egypt
              </p>
            </div>
          </a>
        </div>

        <!-- Sharm El Sheikh -->
        <div class="swiper-slide">
          <a
            href="/destinations/sharm"
            class="group block relative rounded-3xl overflow-hidden shadow-lg"
          >
            <img
              src="/images/sharm-el-sheikh.webp"
              alt="Sharm El Sheikh"
              loading="lazy"
              width="640"
              height="320"
              class="w-full h-80 object-cover group-hover:scale-105 transition duration-500"
