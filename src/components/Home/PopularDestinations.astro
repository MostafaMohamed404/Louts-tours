                Egypt
              </p>
            </div>
          </a>
        </div>

        <!-- Ain Sokhna -->
        <div class="swiper-slide">
          <a
            href="/destinations/sokhna"
            class="group block relative rounded-3xl overflow-hidden shadow-lg"
          >
            <img
              src="/images/el-sokhna.webp"
              alt="Ain Sokhna"
