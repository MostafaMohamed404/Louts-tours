<!-- Our Fleet -->
<section class="py-24 bg-[#F8F5EF]">
  <div class="max-w-7xl mx-auto px-6">

    <!-- Header -->
    <div class="text-center mb-16">
      <span class="text-sm uppercase tracking-widest text-[#C6A75E] font-semibold">
        Our Fleet
      </span>
      <h2 class="text-4xl md:text-5xl font-bold text-[#3E2F1C] mt-4">
        Vehicles for Every Need
      </h2>
      <p class="text-gray-500 mt-4 text-lg max-w-xl mx-auto">
        Modern, well-maintained vehicles driven by experienced, licensed professionals.
      </p>
    </div>

    <!-- Fleet Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

      <!-- Sedan -->
      <div class="bg-white rounded-3xl overflow-hidden shadow-md hover:shadow-xl transition duration-300">
        <div class="h-52 overflow-hidden">
          <img src="/images/transportation/sedan.jpg" alt="Sedan" class="w-full h-full object-cover hover:scale-105 transition duration-500" />
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-[#3E2F1C] mb-2">Economy Sedan</h3>
          <p class="text-gray-500 text-sm mb-4">Perfect for solo travelers or couples. Comfortable and fuel-efficient.</p>
          <div class="flex flex-wrap gap-2">
            <span class="bg-[#F8F5EF] text-[#3E2F1C] text-xs font-medium px-3 py-1 rounded-full">Up to 3 pax</span>
            <span class="bg-[#F8F5EF] text-[#3E2F1C] text-xs font-medium px-3 py-1 rounded-full">A/C</span>
            <span class="bg-[#F8F5EF] text-[#3E2F1C] text-xs font-medium px-3 py-1 rounded-full">WiFi</span>
          </div>
        </div>
      </div>

      <!-- SUV -->
      <div class="bg-white rounded-3xl overflow-hidden shadow-md hover:shadow-xl transition duration-300">
        <div class="h-52 overflow-hidden">
          <img src="/images/transportation/suv.jpg" alt="SUV" class="w-full h-full object-cover hover:scale-105 transition duration-500" />
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-[#3E2F1C] mb-2">Premium SUV</h3>
          <p class="text-gray-500 text-sm mb-4">Spacious and powerful. Great for families and extra luggage.</p>
          <div class="flex flex-wrap gap-2">
            <span class="bg-[#F8F5EF] text-[#3E2F1C] text-xs font-medium px-3 py-1 rounded-full">Up to 6 pax</span>
            <span class="bg-[#F8F5EF] text-[#3E2F1C] text-xs font-medium px-3 py-1 rounded-full">A/C</span>
            <span class="bg-[#F8F5EF] text-[#3E2F1C] text-xs font-medium px-3 py-1 rounded-full">WiFi</span>
          </div>
        </div>
      </div>

      <!-- Bus -->
      <div class="bg-white rounded-3xl overflow-hidden shadow-md hover:shadow-xl transition duration-300">
        <div class="h-52 overflow-hidden">
          <img src="/images/transportation/bus.jpg" alt="Bus" class="w-full h-full object-cover hover:scale-105 transition duration-500" />
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-[#3E2F1C] mb-2">Group Coach</h3>
          <p class="text-gray-500 text-sm mb-4">Fully air-conditioned coaches for large groups and tour packages.</p>
          <div class="flex flex-wrap gap-2">
            <span class="bg-[#F8F5EF] text-[#3E2F1C] text-xs font-medium px-3 py-1 rounded-full">Up to 50 pax</span>
            <span class="bg-[#F8F5EF] text-[#3E2F1C] text-xs font-medium px-3 py-1 rounded-full">A/C</span>
            <span class="bg-[#F8F5EF] text-[#3E2F1C] text-xs font-medium px-3 py-1 rounded-full">Luggage Space</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>