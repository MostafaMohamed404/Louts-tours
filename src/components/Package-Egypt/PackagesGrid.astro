---
// src/components/Package-Egypt/PackagesGrid.astro
import { egyptPackages } from "../../data/egyptPackages";

const filters = [
  { label: "All Packages", value: "all" },
  { label: "5 Days",       value: "5"   },
  { label: "7 Days",       value: "7"   },
  { label: "8-9 Days",     value: "8"   },
];
---

<section id="packages-grid" class="py-20 bg-[#FAF8F5]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center mb-14">
      <div class="inline-flex items-center gap-2 bg-[#C6A75E]/10 border border-[#C6A75E]/30 rounded-full px-5 py-2 mb-5">
        <i class="fa-solid fa-compass text-[#C6A75E] text-sm"></i>
        <span class="text-sm font-medium text-[#C6A75E] tracking-wide">Curated Travel Packages</span>
      </div>

      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4 leading-tight">
        Explore Egypt <span class="text-[#C6A75E]">Your Way</span>
      </h2>

      <p class="text-gray-500 text-lg max-w-2xl mx-auto leading-relaxed">
        13 handpicked journeys — from desert adventures to Nile cruises and Red Sea escapes.
      </p>

      <!-- Stats Bar -->
      <div class="flex flex-wrap justify-center gap-8 mt-8">
        <div class="flex items-center gap-2 text-sm text-gray-500">
          <i class="fa-solid fa-suitcase-rolling text-[#C6A75E] text-xs"></i>
          <span>13 Curated Packages</span>
        </div>
        <div class="w-px h-4 bg-gray-300 self-center hidden sm:block"></div>
        <div class="flex items-center gap-2 text-sm text-gray-500">
          <i class="fa-regular fa-clock text-[#C6A75E] text-xs"></i>
          <span>2 to 9 Days Duration</span>
        </div>
        <div class="w-px h-4 bg-gray-300 self-center hidden sm:block"></div>
        <div class="flex items-center gap-2 text-sm text-gray-500">
          <i class="fa-solid fa-location-dot text-[#C6A75E] text-xs"></i>
          <span>Cairo · Luxor · Aswan · Red Sea</span>
        </div>
      </div>
    </div>

    <!-- Filter Buttons -->
    <div class="flex flex-wrap justify-center gap-3 mb-12" id="filter-bar">
      {filters.map((f) => (
        <button
          data-filter={f.value}
          class={`filter-btn px-6 py-2.5 rounded-2xl text-sm font-medium transition-all duration-200 border
            ${f.value === "all"
              ? "bg-[#C6A75E] text-white border-[#C6A75E] shadow-md"
              : "bg-white text-gray-600 border-gray-200 hover:border-[#C6A75E] hover:text-[#C6A75E]"
            }`}
        >
          {f.value === "all" && <i class="fa-solid fa-grip mr-2 text-xs"></i>}
          {f.value !== "all" && <i class="fa-regular fa-calendar mr-2 text-xs"></i>}
          {f.label}
        </button>
      ))}
    </div>

    <!-- Cards Grid -->
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-7"
      id="packages-container"
    >
      {egyptPackages.map((pkg) => (
        <article
          data-days={pkg.durationDays}
          class="pkg-card group bg-white rounded-2xl overflow-hidden border border-gray-100
                 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col"
        >
          <!-- Image -->
          <div class="relative overflow-hidden h-52">
            <img
              src={pkg.image}
              alt={pkg.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1539768942893-daf53e448371?w=600&q=80';"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>

            <!-- Duration badge -->
            <div class="absolute bottom-3 left-3">
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold backdrop-blur-sm bg-black/30 text-white border border-white/20">
                <i class="fa-regular fa-clock text-[10px]"></i>
                {pkg.duration}
              </span>
            </div>

            <!-- Price badge -->
            <div class="absolute top-3 right-3">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white/90 text-gray-800">
                {pkg.price === "On Request" ? "On Request" : `From ${pkg.price}`}
              </span>
            </div>
          </div>

          <!-- Body -->
          <div class="flex flex-col flex-1 p-5">

            <!-- Route -->
            <div class="flex items-center gap-1.5 flex-wrap mb-3">
              {pkg.locations.map((loc, i) => (
                <>
                  <span class="text-xs text-gray-400 font-medium">{loc}</span>
                  {i < pkg.locations.length - 1 && (
                    <i class="fa-solid fa-arrow-right text-[8px] text-[#C6A75E]"></i>
                  )}
                </>
              ))}
            </div>

            <!-- Title -->
            <h3 class="text-lg font-bold text-gray-900 mb-1 leading-snug group-hover:text-[#C6A75E] transition-colors duration-200">
              {pkg.title}
            </h3>
            <p class="text-xs text-gray-400 mb-3 font-medium">{pkg.subtitle}</p>

            <!-- Description -->
            <p class="text-sm text-gray-500 leading-relaxed mb-4 flex-1">
              {pkg.description}
            </p>

            <!-- Highlights -->
            <ul class="space-y-1.5 mb-5">
              {pkg.highlights.slice(0, 3).map((h) => (
                <li class="flex items-start gap-2 text-xs text-gray-600">
                  <i class="fa-solid fa-check text-[#C6A75E] mt-0.5 flex-shrink-0 text-[10px]"></i>
                  <span>{h}</span>
                </li>
              ))}
            </ul>

            <!-- Includes tags -->
            <div class="flex flex-wrap gap-1.5 mb-5">
              {pkg.includes.slice(0, 3).map((inc) => (
                <span class="text-[10px] bg-gray-50 text-gray-500 border border-gray-100 px-2 py-1 rounded-lg font-medium">
                  {inc}
                </span>
              ))}
            </div>

            <!-- Footer -->
            <div class="flex items-center justify-between pt-4 border-t border-gray-100">
              <div>
                <p class="text-[10px] text-gray-400 uppercase tracking-wider font-medium mb-0.5">Price</p>
                <p class={`font-bold leading-none ${pkg.price === "On Request" ? "text-sm text-gray-500" : "text-xl text-gray-900"}`}>
                  {pkg.price}
                </p>
                <p class="text-[10px] text-gray-400 mt-0.5">{pkg.priceNote}</p>
              </div>

              <a
                href={`/tourism/packages/${pkg.slug}`}
                class="inline-flex items-center gap-2 bg-[#C6A75E] hover:bg-[#b2965c] text-white text-sm font-semibold
                       px-5 py-2.5 rounded-2xl transition-all duration-200 hover:scale-105 shadow-sm hover:shadow-md"
              >
                View Details
                <i class="fa-solid fa-arrow-right text-[10px]"></i>
              </a>
            </div>

          </div>
        </article>
      ))}
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="hidden text-center py-20">
      <i class="fa-solid fa-magnifying-glass text-4xl text-gray-200 mb-4 block"></i>
      <p class="text-gray-400 text-lg">No packages found for this filter.</p>
    </div>

    <!-- Bottom CTA -->
    <div class="mt-16 text-center">
      <p class="text-gray-500 mb-6 text-sm">Can't find what you're looking for? We'll build a custom itinerary for you.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/booking"
          class="inline-flex items-center justify-center gap-3 bg-[#C6A75E] text-white font-semibold
                 px-10 py-4 rounded-2xl hover:bg-[#b2965c] hover:scale-105 transition-all duration-300 shadow-lg"
        >
          <i class="fa-solid fa-suitcase-rolling"></i>
          Book a Package
        </a>
        <a
          href="https://wa.me/201021578641"
          target="_blank"
          class="inline-flex items-center justify-center gap-3 bg-white border border-gray-200
                 text-gray-700 font-semibold px-10 py-4 rounded-2xl hover:border-[#C6A75E]
                 hover:text-[#C6A75E] hover:scale-105 transition-all duration-300 shadow-sm"
        >
          <i class="fa-brands fa-whatsapp text-green-500"></i>
          Custom Package
        </a>
      </div>
    </div>

  </div>
</section>

<!-- Filter Script -->
<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const cards      = document.querySelectorAll<HTMLElement>("[data-days]");
  const emptyState = document.getElementById("empty-state");

  function applyFilter(value: string) {
    let visible = 0;

    cards.forEach((card) => {
      const days = Number(card.dataset.days);
      const match =
        value === "all"                    ||
        (value === "5" && days <= 5)       ||
        (value === "7" && days === 7)      ||
        (value === "8" && days >= 8);

      card.style.display = match ? "flex" : "none";
      if (match) visible++;
    });

    emptyState?.classList.toggle("hidden", visible > 0);

    filterBtns.forEach((btn) => {
      const active = btn.dataset.filter === value;
      btn.classList.toggle("bg-[#C6A75E]",    active);
      btn.classList.toggle("text-white",        active);
      btn.classList.toggle("border-[#C6A75E]",  active);
      btn.classList.toggle("shadow-md",         active);
      btn.classList.toggle("bg-white",         !active);
      btn.classList.toggle("text-gray-600",    !active);
      btn.classList.toggle("border-gray-200",  !active);
    });
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => applyFilter(btn.dataset.filter ?? "all"));
  });
</script>